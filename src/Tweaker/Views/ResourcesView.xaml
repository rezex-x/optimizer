<UserControl x:Class="Tweaker.Views.ResourcesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:conv="clr-namespace:Tweaker.Converters">
    <UserControl.Resources>
        <conv:BoolToVisibilityConverter x:Key="BoolToVis" />
    </UserControl.Resources>
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="140" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0" BorderBrush="{StaticResource BorderSubtle}" BorderThickness="0,0,1,0">
            <StackPanel>
                <TextBlock Text="SECTION" Style="{StaticResource Label10}"
                           Foreground="{StaticResource TextFaint}" Margin="14,16,12,6" />
                <Button Command="{Binding SelectTabCommand}" CommandParameter="Profiles"
                        Tag="{Binding IsProfiles}" Style="{StaticResource SubTabButton}">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="App Profiles" />
                        <Ellipse Width="5" Height="5" Fill="{StaticResource AccentText}" Margin="6,0,0,0" VerticalAlignment="Center"
                                 Visibility="{Binding IsProfileActive, Converter={StaticResource BoolToVis}}" />
                    </StackPanel>
                </Button>
                <Button Content="Processes" Command="{Binding SelectTabCommand}" CommandParameter="Processes"
                        Tag="{Binding IsProcesses}" Style="{StaticResource SubTabButton}" />
                <Button Content="Performance" Command="{Binding SelectTabCommand}" CommandParameter="Performance"
                        Tag="{Binding IsPerformance}" Style="{StaticResource SubTabButton}" />
                <Button Content="Network" Command="{Binding SelectTabCommand}" CommandParameter="Network"
                        Tag="{Binding IsNetwork}" Style="{StaticResource SubTabButton}" />
                <Button Content="Services" Command="{Binding SelectTabCommand}" CommandParameter="Services"
                        Tag="{Binding IsServices}" Style="{StaticResource SubTabButton}" />
            </StackPanel>
        </Border>

        <ContentControl Grid.Column="1" Content="{Binding Current}" />
    </Grid>
</UserControl>

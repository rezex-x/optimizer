<UserControl x:Class="Tweaker.Views.ServicesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:conv="clr-namespace:Tweaker.Converters"
             xmlns:controls="clr-namespace:Tweaker.Controls">
    <UserControl.Resources>
        <conv:BoolToVisibilityConverter x:Key="BoolToVis" />
        <Style x:Key="SegGroup" TargetType="Border">
            <Setter Property="BorderBrush" Value="{StaticResource BorderInput}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="3" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
    </UserControl.Resources>

    <DockPanel>
        <Border DockPanel.Dock="Top" Style="{StaticResource ToolbarBorder}">
            <DockPanel>
                <TextBlock DockPanel.Dock="Right" Text="{Binding Message}" FontSize="11" Foreground="{StaticResource TextDim}"
                           VerticalAlignment="Center" TextTrimming="CharacterEllipsis" MaxWidth="340" Margin="12,0,0,0" />
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Grid Width="200" Margin="0,0,8,0" VerticalAlignment="Center">
                        <TextBox Style="{StaticResource InputBox}" Padding="26,4,8,4"
                                 Text="{Binding Filter, UpdateSourceTrigger=PropertyChanged}" />
                        <Canvas Width="12" Height="12" HorizontalAlignment="Left" Margin="8,0,0,0" VerticalAlignment="Center"
                                IsHitTestVisible="False">
                            <Ellipse Canvas.Left="1" Canvas.Top="1" Width="8" Height="8"
                                     Stroke="{StaticResource TextFaint}" StrokeThickness="1.2" />
                            <Line X1="8" Y1="8" X2="11.5" Y2="11.5" Stroke="{StaticResource TextFaint}"
                                  StrokeThickness="1.2" StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
                        </Canvas>
                        <TextBlock Text="Filter services…" Foreground="{StaticResource TextFaint}" FontSize="12"
                                   Margin="29,0,0,0" VerticalAlignment="Center" IsHitTestVisible="False">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Filter}" Value="">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </Grid>
                    <Border Style="{StaticResource SegGroup}">
                        <StackPanel Orientation="Horizontal">
                            <Button Content="All" Command="{Binding SetGroupCommand}" CommandParameter="All"
                                    Tag="{Binding IsAllGroups}" Style="{StaticResource SegmentedButton}" />
                            <Button Content="Third-party" Command="{Binding SetGroupCommand}" CommandParameter="ThirdParty"
                                    Tag="{Binding IsThirdPartyOnly}" Style="{StaticResource SegmentedButton}" BorderThickness="1,0,0,0" />
                            <Button Content="Windows" Command="{Binding SetGroupCommand}" CommandParameter="Windows"
                                    Tag="{Binding IsWindowsOnly}" Style="{StaticResource SegmentedButton}" BorderThickness="1,0,0,0" />
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource SegGroup}" Margin="8,0,0,0">
                        <StackPanel Orientation="Horizontal">
                            <Button Content="Any status" Command="{Binding SetStatusCommand}" CommandParameter="Any"
                                    Tag="{Binding IsAnyStatus}" Style="{StaticResource SegmentedButton}" />
                            <Button Content="Running" Command="{Binding SetStatusCommand}" CommandParameter="Running"
                                    Tag="{Binding IsRunningOnly}" Style="{StaticResource SegmentedButton}" BorderThickness="1,0,0,0" />
                            <Button Content="Stopped" Command="{Binding SetStatusCommand}" CommandParameter="Stopped"
                                    Tag="{Binding IsStoppedOnly}" Style="{StaticResource SegmentedButton}" BorderThickness="1,0,0,0" />
                        </StackPanel>
                    </Border>
                    <TextBlock Text="{Binding CountText}" FontSize="11" Foreground="{StaticResource TextDim}" Margin="12,0,0,0"
                               VerticalAlignment="Center" />
                </StackPanel>
            </DockPanel>
        </Border>

        <DataGrid x:Name="Table" Style="{StaticResource DataTable}" CanUserSortColumns="False"
                  VirtualizingPanel.IsVirtualizingWhenGrouping="True">
            <DataGrid.GroupStyle>
                <GroupStyle>
                    <GroupStyle.HeaderTemplate>
                        <DataTemplate>
                            <Border Background="{StaticResource BgPanel}" BorderBrush="{StaticResource BorderSubtle}"
                                    BorderThickness="0,0,0,1" Padding="10,10,10,5">
                                <TextBlock Style="{StaticResource Label10}"><Run Text="{Binding Name, Mode=OneWay}" /><Run Text=" (" /><Run Text="{Binding ItemCount, Mode=OneWay}" /><Run Text=")" /></TextBlock>
                            </Border>
                        </DataTemplate>
                    </GroupStyle.HeaderTemplate>
                </GroupStyle>
            </DataGrid.GroupStyle>
            <DataGrid.Columns>
                <DataGridTemplateColumn Header="NAME" Width="1.4*">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <StackPanel VerticalAlignment="Center">
                                <DockPanel>
                                    <controls:Badge DockPanel.Dock="Right" Text="PROFILE" Tone="Medium" Margin="6,0,0,0" VerticalAlignment="Center"
                                                    Visibility="{Binding IsProfileManaged, Converter={StaticResource BoolToVis}}" />
                                    <controls:Badge DockPanel.Dock="Right" Text="{Binding AdviceText}" Tone="{Binding AdviceTone}"
                                                    ToolTip="{Binding AdviceReason}" Margin="6,0,0,0" VerticalAlignment="Center"
                                                    Visibility="{Binding HasAdvice, Converter={StaticResource BoolToVis}}" />
                                    <TextBlock Text="{Binding DisplayName}" Foreground="{StaticResource TextName}" TextTrimming="CharacterEllipsis" />
                                </DockPanel>
                                <TextBlock Text="{Binding Name}" FontFamily="{StaticResource MonoFont}" FontSize="10"
                                           Foreground="{StaticResource TextFaint}" Margin="0,1,0,0" TextTrimming="CharacterEllipsis" />
                            </StackPanel>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTemplateColumn Header="DESCRIPTION" Width="2*">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding Description}" FontSize="11" Foreground="{StaticResource TextDim}"
                                       TextWrapping="Wrap" TextTrimming="CharacterEllipsis" MaxHeight="30" VerticalAlignment="Center" />
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTemplateColumn Header="STATUS" Width="96">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <TextBlock x:Name="Status" FontSize="11" Foreground="{StaticResource TextDim}" VerticalAlignment="Center">
                                <Run Text="●" /> <Run Text="{Binding StatusText, Mode=OneWay}" />
                            </TextBlock>
                            <DataTemplate.Triggers>
                                <DataTrigger Binding="{Binding IsRunning}" Value="True">
                                    <Setter TargetName="Status" Property="Foreground" Value="{StaticResource AccentText}" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding IsPending}" Value="True">
                                    <Setter TargetName="Status" Property="Foreground" Value="{StaticResource LevelWarm}" />
                                </DataTrigger>
                            </DataTemplate.Triggers>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTemplateColumn Header="STARTUP" Width="130">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <TextBlock x:Name="Startup" Text="{Binding StartupText}" FontSize="11" Foreground="{StaticResource TextMuted}"
                                       VerticalAlignment="Center" />
                            <DataTemplate.Triggers>
                                <DataTrigger Binding="{Binding IsDisabled}" Value="True">
                                    <Setter TargetName="Startup" Property="Foreground" Value="{StaticResource CoreHot}" />
                                </DataTrigger>
                            </DataTemplate.Triggers>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTextColumn Header="PID" Binding="{Binding PidText, Mode=OneWay}" Width="64"
                                    ElementStyle="{StaticResource TableCellMono}" />
                <DataGridTemplateColumn Header="" Width="96">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <Grid HorizontalAlignment="Right" Margin="0,0,4,0">
                                <TextBlock Text="{Binding LockText}" FontSize="10" Foreground="{StaticResource TextFaint}" VerticalAlignment="Center"
                                           Visibility="{Binding ShowLock, Converter={StaticResource BoolToVis}}" />
                                <Button Content="Stop" Style="{StaticResource DangerButtonSm}"
                                        Command="{Binding DataContext.StopCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                        CommandParameter="{Binding}"
                                        Visibility="{Binding ShowStop, Converter={StaticResource BoolToVis}}" />
                                <Button Content="Confirm" Style="{StaticResource DangerButtonSm}"
                                        Command="{Binding DataContext.ConfirmStopCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                        CommandParameter="{Binding}"
                                        Visibility="{Binding ShowConfirm, Converter={StaticResource BoolToVis}}" />
                                <Button Content="Start" Style="{StaticResource AccentButtonSm}" IsEnabled="{Binding CanStart}"
                                        Command="{Binding DataContext.StartCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                        CommandParameter="{Binding}"
                                        Visibility="{Binding ShowStart, Converter={StaticResource BoolToVis}}" />
                            </Grid>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
            </DataGrid.Columns>
        </DataGrid>
    </DockPanel>
</UserControl>

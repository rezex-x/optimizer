<Window x:Class="Tweaker.Views.ConfirmDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:conv="clr-namespace:Tweaker.Converters"
        WindowStartupLocation="CenterOwner" SizeToContent="Height" Width="460"
        WindowStyle="None" ResizeMode="NoResize" AllowsTransparency="True" Background="Transparent"
        ShowInTaskbar="False">
    <Window.Resources>
        <conv:BoolToVisibilityConverter x:Key="BoolToVis" />
    </Window.Resources>
    <Border Background="{StaticResource BgCard}" BorderBrush="{StaticResource BorderCard}" BorderThickness="1" CornerRadius="6">
        <StackPanel>
            <Border Background="{StaticResource BgPanel}" BorderBrush="{StaticResource BorderSubtle}" BorderThickness="0,0,0,1" Padding="18,14">
                <TextBlock Text="{Binding Heading}" FontFamily="{StaticResource AppFont}" FontSize="14"
                           Foreground="{StaticResource TextActive}" TextWrapping="Wrap" />
            </Border>

            <StackPanel Margin="18,14,18,4" Visibility="{Binding IsSingle, Converter={StaticResource BoolToVis}}">
                <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                    <Border CornerRadius="2" Padding="6,2" Background="{StaticResource BgInput}" BorderBrush="{StaticResource BorderInput}" BorderThickness="1">
                        <TextBlock Text="{Binding RiskText}" FontSize="9" Foreground="{StaticResource TextMuted}" />
                    </Border>
                    <TextBlock Text="{Binding Category}" FontSize="11" Foreground="{StaticResource TextMuted}" VerticalAlignment="Center" Margin="8,0,0,0" />
                    <Border CornerRadius="2" Padding="6,2" Margin="8,0,0,0" Background="{StaticResource BgInput}" BorderBrush="{StaticResource BorderInput}" BorderThickness="1"
                            Visibility="{Binding ShowRestart, Converter={StaticResource BoolToVis}}">
                        <TextBlock Text="restart" FontSize="9" Foreground="{StaticResource TextMuted}" />
                    </Border>
                </StackPanel>
                <StackPanel Margin="0,0,0,10" Visibility="{Binding HasDescription, Converter={StaticResource BoolToVis}}">
                    <TextBlock Text="WHAT IT DOES" Style="{StaticResource Label10}" Foreground="{StaticResource TextDim}" Margin="0,0,0,3" />
                    <TextBlock Text="{Binding Description}" FontSize="12" Foreground="{StaticResource TextPrimary}" TextWrapping="Wrap" />
                </StackPanel>
                <StackPanel Margin="0,0,0,10" Visibility="{Binding HasBenefit, Converter={StaticResource BoolToVis}}">
                    <TextBlock Text="YOU GAIN" Style="{StaticResource Label10}" Foreground="{StaticResource AccentText}" Margin="0,0,0,3" />
                    <TextBlock Text="{Binding Benefit}" FontSize="12" Foreground="{StaticResource TextPrimary}" TextWrapping="Wrap" />
                </StackPanel>
                <StackPanel Margin="0,0,0,10" Visibility="{Binding HasDownsides, Converter={StaticResource BoolToVis}}">
                    <TextBlock Text="DOWNSIDES" Style="{StaticResource Label10}" Foreground="{StaticResource TextMuted}" Margin="0,0,0,3" />
                    <TextBlock Text="{Binding Downsides}" FontSize="12" Foreground="{StaticResource TextName}" TextWrapping="Wrap" />
                </StackPanel>
            </StackPanel>

            <StackPanel Margin="18,14,18,4" Visibility="{Binding IsBatch, Converter={StaticResource BoolToVis}}">
                <ScrollViewer Style="{StaticResource ThemedScroll}" MaxHeight="360">
                    <ItemsControl ItemsSource="{Binding Rows}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border BorderBrush="{StaticResource RowDivider}" BorderThickness="0,0,0,1" Padding="0,7">
                                    <StackPanel Orientation="Horizontal">
                                        <Border CornerRadius="2" Padding="5,1" Background="{StaticResource BgInput}" BorderBrush="{StaticResource BorderInput}" BorderThickness="1" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding RiskText}" FontSize="9" Foreground="{Binding RiskFg}" />
                                        </Border>
                                        <TextBlock Text="{Binding Name}" FontSize="12" Foreground="{StaticResource TextName}" VerticalAlignment="Center" Margin="8,0,0,0" />
                                        <TextBlock Text="restart" FontSize="9" Foreground="{StaticResource TextMuted}" VerticalAlignment="Center" Margin="8,0,0,0"
                                                   Visibility="{Binding ShowRestart, Converter={StaticResource BoolToVis}}" />
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
                <TextBlock Text="{Binding RestartSummary}" FontSize="11" Foreground="{StaticResource TextMuted}" Margin="0,8,0,0"
                           Visibility="{Binding HasRestartSummary, Converter={StaticResource BoolToVis}}" />
            </StackPanel>

            <Border Background="#3A1414" BorderBrush="#5A2A2A" BorderThickness="1" CornerRadius="4" Margin="18,4,18,4" Padding="12,8"
                    Visibility="{Binding HasWarning, Converter={StaticResource BoolToVis}}">
                <TextBlock Text="{Binding Warning}" FontSize="11" Foreground="#E8B0B0" TextWrapping="Wrap" />
            </Border>

            <Border BorderBrush="{StaticResource BorderSubtle}" BorderThickness="0,1,0,0" Padding="18,12" Margin="0,10,0,0">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Content="Cancel" Style="{StaticResource GhostButton}" Margin="0,0,8,0" Click="Cancel_Click" />
                    <Button Content="{Binding ApplyLabel}" Style="{StaticResource AccentButton}" Click="Apply_Click" />
                </StackPanel>
            </Border>
        </StackPanel>
    </Border>
</Window>

<UserControl x:Class="Tweaker.Views.InspectorView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib"
             xmlns:controls="clr-namespace:Tweaker.Controls"
             xmlns:conv="clr-namespace:Tweaker.Converters"
             AllowDrop="True" Drop="OnDrop" Background="Transparent">
    <UserControl.Resources>
        <conv:BoolToVisibilityConverter x:Key="BoolToVis" />
        <Style x:Key="InspCard" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource BgCard}" />
            <Setter Property="BorderBrush" Value="{StaticResource BorderCard}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="4" />
        </Style>
        <Style x:Key="InspInput" TargetType="TextBox" BasedOn="{StaticResource MonoInputBox}">
            <Setter Property="AcceptsReturn" Value="False" />
            <Setter Property="TextWrapping" Value="NoWrap" />
        </Style>
        <Style x:Key="SectionButton" TargetType="Button">
            <Setter Property="FontFamily" Value="{StaticResource AppFont}" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Foreground" Value="{StaticResource TextDim}" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="b" Background="Transparent" BorderThickness="2,0,0,0" BorderBrush="Transparent" Padding="12,6">
                            <ContentPresenter />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Foreground" Value="{StaticResource TextMuted}" />
                            </Trigger>
                            <Trigger Property="Tag">
                                <Trigger.Value><sys:Boolean>True</sys:Boolean></Trigger.Value>
                                <Setter TargetName="b" Property="Background" Value="{StaticResource BgNavActive}" />
                                <Setter TargetName="b" Property="BorderBrush" Value="{StaticResource NavAccent}" />
                                <Setter Property="Foreground" Value="{StaticResource TextActive}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid>
        <ScrollViewer Style="{StaticResource ThemedScroll}" HorizontalScrollBarVisibility="Disabled"
                      Visibility="{Binding IsClosed, Converter={StaticResource BoolToVis}}">
            <StackPanel Width="540" Margin="0,40,0,24" HorizontalAlignment="Center">
                <Grid Height="150">
                    <Rectangle Stroke="{StaticResource BorderInput}" StrokeThickness="1" StrokeDashArray="4 3" RadiusX="6" RadiusY="6" />
                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                        <TextBlock Text="Drop a config file here" FontSize="13" Foreground="{StaticResource TextMuted}" HorizontalAlignment="Center" />
                        <TextBlock Text=".ini · .cfg · .json · .txt" FontSize="11" Foreground="{StaticResource TextDim}" HorizontalAlignment="Center" Margin="0,4,0,12" />
                        <Button Content="Open file…" Style="{StaticResource DefaultButton}" HorizontalAlignment="Center" Click="OpenFile_Click" />
                    </StackPanel>
                </Grid>
                <TextBlock Text="{Binding Message}" FontSize="11" Foreground="{StaticResource TextDim}" TextWrapping="Wrap" Margin="0,10,0,0"
                           HorizontalAlignment="Center" />

                <TextBlock Text="GAME CONFIGS FOUND ON THIS PC" Style="{StaticResource Label10}" Margin="0,24,0,8" />
                <Border Style="{StaticResource InspCard}" Visibility="{Binding HasDetected, Converter={StaticResource BoolToVis}}">
                    <ItemsControl ItemsSource="{Binding Detected}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border BorderBrush="{StaticResource RowDivider}" BorderThickness="0,0,0,1" Padding="13,9">
                                    <DockPanel>
                                        <Button DockPanel.Dock="Right" Content="Open" Style="{StaticResource AccentButtonSm}" VerticalAlignment="Center" Margin="10,0,0,0"
                                                Command="{Binding DataContext.OpenDetectedCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                CommandParameter="{Binding}" />
                                        <controls:Badge DockPanel.Dock="Right" Text="PRESET" Tone="Info" VerticalAlignment="Center"
                                                        Visibility="{Binding HasPreset, Converter={StaticResource BoolToVis}}" />
                                        <StackPanel>
                                            <TextBlock FontSize="12" Foreground="{StaticResource TextName}">
                                                <Run Text="{Binding Game, Mode=OneWay}" /> <Run Text="·" Foreground="{StaticResource TextDim}" /> <Run Text="{Binding FileName, Mode=OneWay}" FontFamily="{StaticResource MonoFont}" FontSize="11" Foreground="{StaticResource TextDim}" />
                                            </TextBlock>
                                            <TextBlock Text="{Binding DisplayPath}" FontFamily="{StaticResource MonoFont}" FontSize="10" Foreground="{StaticResource TextFaint}"
                                                       Margin="0,1,0,0" TextTrimming="CharacterEllipsis" />
                                        </StackPanel>
                                    </DockPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </Border>
                <TextBlock Text="No Fortnite, VALORANT, CS2 or Apex configs found. Open any .ini, .cfg, .json or .txt config instead."
                           FontSize="11" Foreground="{StaticResource TextDim}" TextWrapping="Wrap"
                           Visibility="{Binding HasDetected, Converter={StaticResource BoolToVis}, ConverterParameter=invert}" />
            </StackPanel>
        </ScrollViewer>

        <DockPanel Visibility="{Binding IsOpen, Converter={StaticResource BoolToVis}}">
            <Border DockPanel.Dock="Left" Width="200" BorderBrush="{StaticResource BorderSubtle}" BorderThickness="0,0,1,0">
                <DockPanel>
                    <Border DockPanel.Dock="Top" Padding="12,12,12,10" BorderBrush="{StaticResource RowDivider}" BorderThickness="0,0,0,1">
                        <StackPanel>
                            <TextBlock Text="{Binding FileName}" FontFamily="{StaticResource MonoFont}" FontSize="11" Foreground="{StaticResource TextName}"
                                       TextTrimming="CharacterEllipsis" />
                            <TextBlock Text="{Binding CountsText}" FontSize="10" Foreground="{StaticResource TextDim}" Margin="0,3,0,6" />
                            <controls:Badge Text="{Binding PresetBadge}" Tone="Info" HorizontalAlignment="Left"
                                            Visibility="{Binding HasPreset, Converter={StaticResource BoolToVis}}" />
                        </StackPanel>
                    </Border>
                    <StackPanel DockPanel.Dock="Bottom" Margin="12">
                        <Button Content="{Binding SaveText}" Style="{StaticResource AccentButton}" Command="{Binding SaveCommand}"
                                IsEnabled="{Binding CanSave}" Margin="0,0,0,6" />
                        <Button Content="Revert" Style="{StaticResource GhostButton}" Command="{Binding RevertCommand}"
                                IsEnabled="{Binding CanRevert}" Margin="0,0,0,6" />
                        <Button Content="{Binding CloseText}" Style="{StaticResource GhostButton}" Command="{Binding CloseCommand}" />
                    </StackPanel>
                    <ScrollViewer Style="{StaticResource ThemedScroll}" HorizontalScrollBarVisibility="Disabled" Padding="0,6,0,0">
                        <ItemsControl ItemsSource="{Binding Sections}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Button Style="{StaticResource SectionButton}" Tag="{Binding IsActive}"
                                            Command="{Binding DataContext.SelectSectionCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                            CommandParameter="{Binding}">
                                        <TextBlock Text="{Binding Label}" TextTrimming="CharacterEllipsis" />
                                    </Button>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </DockPanel>
            </Border>

            <Border DockPanel.Dock="Top" Style="{StaticResource ToolbarBorder}">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Right" Text="{Binding StatusText}" FontSize="11" Foreground="{StaticResource TextDim}"
                               VerticalAlignment="Center" TextTrimming="CharacterEllipsis" MaxWidth="360" Margin="12,0,0,0" />
                    <TextBlock Text="{Binding PathText}" FontFamily="{StaticResource MonoFont}" FontSize="11" Foreground="{StaticResource TextDim}"
                               VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                </DockPanel>
            </Border>
            <Border DockPanel.Dock="Top" Background="{StaticResource ToneMediumBg}" BorderBrush="{StaticResource ToneMediumBorder}"
                    BorderThickness="0,0,0,1" Padding="16,8" Visibility="{Binding ShowGameWarning, Converter={StaticResource BoolToVis}}">
                <TextBlock Text="{Binding GameWarning}" FontSize="11" Foreground="{StaticResource ToneMediumFg}" TextWrapping="Wrap" />
            </Border>

            <ScrollViewer Style="{StaticResource ThemedScroll}" HorizontalScrollBarVisibility="Disabled">
                <StackPanel>
                    <TextBlock Text="No editable values in this file." FontSize="12" Foreground="{StaticResource TextDim}" Margin="16,14"
                               Visibility="{Binding IsEmptyFile, Converter={StaticResource BoolToVis}}" />
                    <ItemsControl ItemsSource="{Binding Groups}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <StackPanel>
                                    <Border Background="{StaticResource BgTitle}" BorderBrush="{StaticResource RowDivider}" BorderThickness="0,0,0,1" Padding="14,9,14,6">
                                        <TextBlock Text="{Binding Title}" FontFamily="{StaticResource MonoFont}" FontSize="10" Foreground="{StaticResource TextDim}" />
                                    </Border>
                                    <ItemsControl ItemsSource="{Binding Entries}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border x:Name="Row" BorderBrush="{StaticResource RowDivider}" BorderThickness="0,0,0,1" Padding="14,9">
                                                    <Border x:Name="Bar" BorderThickness="2,0,0,0" BorderBrush="Transparent" Padding="8,0,0,0" Margin="-10,0,0,0">
                                                        <StackPanel>
                                                            <DockPanel>
                                                                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                                                                    <CheckBox Style="{StaticResource PillToggle}" IsChecked="{Binding IsOn}"
                                                                              Visibility="{Binding IsToggle, Converter={StaticResource BoolToVis}}" />
                                                                    <ComboBox Style="{StaticResource DarkCombo}" MinWidth="170" ItemsSource="{Binding Options}"
                                                                              SelectedItem="{Binding SelectedOption}" DisplayMemberPath="Label"
                                                                              Visibility="{Binding IsChoice, Converter={StaticResource BoolToVis}}" />
                                                                    <TextBox Style="{StaticResource InspInput}" Width="90" TextAlignment="Right"
                                                                             Text="{Binding NumberText}" PreviewKeyDown="NumberBox_KeyDown"
                                                                             Visibility="{Binding IsSlider, Converter={StaticResource BoolToVis}}" />
                                                                    <TextBox Style="{StaticResource InspInput}" MinWidth="220" MaxWidth="360" TextAlignment="Right"
                                                                             Text="{Binding Text, UpdateSourceTrigger=PropertyChanged}"
                                                                             Visibility="{Binding IsText, Converter={StaticResource BoolToVis}}" />
                                                                </StackPanel>
                                                                <StackPanel VerticalAlignment="Center" Margin="0,0,12,0">
                                                                    <StackPanel Orientation="Horizontal">
                                                                        <TextBlock x:Name="KeyText" Text="{Binding Key}" FontFamily="{StaticResource MonoFont}" FontSize="12"
                                                                                   Foreground="{StaticResource TextName}" TextTrimming="CharacterEllipsis" />
                                                                        <Ellipse Width="5" Height="5" Fill="{StaticResource AccentText}" Margin="6,0,0,0" VerticalAlignment="Center"
                                                                                 Visibility="{Binding IsDirty, Converter={StaticResource BoolToVis}}" />
                                                                        <controls:Badge Text="RANGE GUESSED" Tone="Neutral" Margin="8,0,0,0" VerticalAlignment="Center"
                                                                                        Visibility="{Binding IsGuessed, Converter={StaticResource BoolToVis}}" />
                                                                    </StackPanel>
                                                                    <TextBlock Text="{Binding Hint}" FontSize="10" Foreground="{StaticResource TextDim}" Margin="0,1,0,0"
                                                                               Visibility="{Binding HasHint, Converter={StaticResource BoolToVis}}" />
                                                                </StackPanel>
                                                            </DockPanel>
                                                            <StackPanel Margin="0,6,0,0" Visibility="{Binding IsSlider, Converter={StaticResource BoolToVis}}">
                                                                <Slider Style="{StaticResource DarkSlider}" Minimum="{Binding Min}" Maximum="{Binding Max}" SmallChange="{Binding Step}"
                                                                        LargeChange="{Binding Step}" TickFrequency="{Binding Step}" IsSnapToTickEnabled="True"
                                                                        Value="{Binding Number}" />
                                                                <DockPanel>
                                                                    <TextBlock DockPanel.Dock="Right" Text="{Binding MaxText}" FontFamily="{StaticResource MonoFont}" FontSize="10"
                                                                               Foreground="{StaticResource TextFaint}" />
                                                                    <TextBlock Text="{Binding MinText}" FontFamily="{StaticResource MonoFont}" FontSize="10"
                                                                               Foreground="{StaticResource TextFaint}" />
                                                                </DockPanel>
                                                            </StackPanel>
                                                        </StackPanel>
                                                    </Border>
                                                </Border>
                                                <DataTemplate.Triggers>
                                                    <DataTrigger Binding="{Binding IsDirty}" Value="True">
                                                        <Setter TargetName="Bar" Property="BorderBrush" Value="{StaticResource NavAccent}" />
                                                        <Setter TargetName="KeyText" Property="Foreground" Value="{StaticResource AccentText}" />
                                                    </DataTrigger>
                                                </DataTemplate.Triggers>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </ScrollViewer>
        </DockPanel>
    </Grid>
</UserControl>

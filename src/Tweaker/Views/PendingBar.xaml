<UserControl x:Class="Tweaker.Views.PendingBar"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:conv="clr-namespace:Tweaker.Converters"
             xmlns:controls="clr-namespace:Tweaker.Controls"
             x:Name="Root">
    <UserControl.Resources>
        <conv:BoolToVisibilityConverter x:Key="BoolToVis" />
        <conv:UpperCaseConverter x:Key="Upper" />
        <conv:RiskBadgeConverter x:Key="RiskBadge" />

        <Style x:Key="BarGlyphButton" TargetType="Button">
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Foreground" Value="{StaticResource TextMuted}" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="Transparent" Padding="6,2">
                            <ContentPresenter VerticalAlignment="Center" HorizontalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Foreground" Value="{StaticResource TextName}" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.4" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="DetailLine" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11" />
            <Setter Property="Foreground" Value="{StaticResource TextBody}" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="Margin" Value="0,3,0,0" />
        </Style>
    </UserControl.Resources>

    <Border Background="{StaticResource BgPanel}" BorderBrush="{StaticResource BorderSubtle}" BorderThickness="0,1,0,0">
        <DockPanel>
            <DockPanel DockPanel.Dock="Top" Margin="16,8,16,6">
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Command="{Binding ToggleAllDetailsCommand}" IsEnabled="{Binding CanEdit}" Margin="0,0,8,0">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource GhostButtonSm}">
                                <Setter Property="Content" Value="Show all details" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding ShowAllDetails}" Value="True">
                                        <Setter Property="Content" Value="Hide details" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>
                    <Button Content="Revert" Style="{StaticResource DangerButtonSm}" Command="{Binding DiscardCommand}"
                            IsEnabled="{Binding CanEdit}" Margin="0,0,8,0"
                            ToolTip="Discard every queued change and put the switches back" />
                    <Button Content="Apply" Style="{StaticResource AccentButtonSm}" Command="{Binding ApplyCommand}"
                            IsEnabled="{Binding CanEdit}" ToolTip="Run every queued change, one at a time" />
                </StackPanel>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Ellipse Width="6" Height="6" Fill="{StaticResource ToneMediumFg}" Margin="0,0,8,0" VerticalAlignment="Center" />
                    <TextBlock Text="{Binding Summary}" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource TextName}"
                               VerticalAlignment="Center" />
                    <TextBlock Text="{Binding Progress}" FontFamily="{StaticResource MonoFont}" FontSize="11"
                               Foreground="{StaticResource LogText}" VerticalAlignment="Center" Margin="12,0,0,0"
                               Visibility="{Binding IsApplying, Converter={StaticResource BoolToVis}}" />
                </StackPanel>
            </DockPanel>

            <ScrollViewer Style="{StaticResource ThemedScroll}" MaxHeight="220" Padding="16,0,16,8">
                <ItemsControl ItemsSource="{Binding Items}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Background="{StaticResource BgCard}" BorderBrush="{StaticResource BorderCard}" BorderThickness="1"
                                    CornerRadius="3" Padding="10,6" Margin="0,0,0,4">
                                <StackPanel>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,10,0">
                                            <controls:Badge Tone="Info" VerticalAlignment="Center"
                                                            Text="{Binding ActionText, Converter={StaticResource Upper}}" />
                                            <Border CornerRadius="2" Padding="5,1" Margin="6,0,0,0" VerticalAlignment="Center" BorderThickness="1"
                                                    Background="{StaticResource BgCard}" BorderBrush="{StaticResource BorderInput}"
                                                    Visibility="{Binding IsIrreversible, Converter={StaticResource BoolToVis}}">
                                                <TextBlock Text="one-time · can't be undone" FontSize="9" Foreground="{StaticResource TextMuted}" />
                                            </Border>
                                        </StackPanel>
                                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Name}" FontSize="12" Foreground="{StaticResource TextName}"
                                                       VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                            <Border CornerRadius="2" Padding="5,1" Margin="8,0,0,0" VerticalAlignment="Center" BorderThickness="1"
                                                    Background="{Binding Risk, Converter={StaticResource RiskBadge}, ConverterParameter=bg}"
                                                    BorderBrush="{Binding Risk, Converter={StaticResource RiskBadge}, ConverterParameter=border}">
                                                <TextBlock Text="{Binding Risk, Converter={StaticResource Upper}}" FontSize="9"
                                                           Foreground="{Binding Risk, Converter={StaticResource RiskBadge}, ConverterParameter=fg}" />
                                            </Border>
                                            <Border CornerRadius="2" Padding="5,1" Margin="6,0,0,0" VerticalAlignment="Center" BorderThickness="1"
                                                    Background="{StaticResource BgCard}" BorderBrush="{StaticResource BorderInput}"
                                                    Visibility="{Binding RequiresRestart, Converter={StaticResource BoolToVis}}">
                                                <TextBlock Text="restart" FontSize="9" Foreground="{StaticResource TextMuted}" />
                                            </Border>
                                        </StackPanel>
                                        <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                            <Button Command="{Binding ToggleCommand}" ToolTip="Details">
                                                <Button.Style>
                                                    <Style TargetType="Button" BasedOn="{StaticResource BarGlyphButton}">
                                                        <Setter Property="Content" Value="▾" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsExpanded}" Value="True">
                                                                <Setter Property="Content" Value="▴" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Button.Style>
                                            </Button>
                                            <Button Content="×" Style="{StaticResource BarGlyphButton}" FontSize="13"
                                                    Command="{Binding RemoveCommand}" CommandParameter="{Binding}"
                                                    IsEnabled="{Binding DataContext.CanEdit, ElementName=Root}"
                                                    ToolTip="Take this change off the queue" />
                                        </StackPanel>
                                    </Grid>
                                    <TextBlock FontSize="11" Foreground="{StaticResource DangerText}" TextWrapping="Wrap" Margin="0,4,0,0"
                                               Visibility="{Binding HasWarning, Converter={StaticResource BoolToVis}}">
                                        <Run Text="⚠ " /><Run Text="{Binding WarningText, Mode=OneWay}" />
                                    </TextBlock>
                                    <StackPanel Margin="0,2,0,2" Visibility="{Binding IsExpanded, Converter={StaticResource BoolToVis}}">
                                        <TextBlock Text="{Binding Description}">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock" BasedOn="{StaticResource DetailLine}">
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding Description}" Value="">
                                                            <Setter Property="Visibility" Value="Collapsed" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                        <TextBlock>
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock" BasedOn="{StaticResource DetailLine}">
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding Benefit}" Value="">
                                                            <Setter Property="Visibility" Value="Collapsed" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                            <Run Text="+ " Foreground="{StaticResource AccentText}" /><Run Text="{Binding Benefit, Mode=OneWay}" />
                                        </TextBlock>
                                        <TextBlock>
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock" BasedOn="{StaticResource DetailLine}">
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding Downsides}" Value="">
                                                            <Setter Property="Visibility" Value="Collapsed" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                            <Run Text="− " Foreground="{StaticResource DangerText}" /><Run Text="{Binding Downsides, Mode=OneWay}" />
                                        </TextBlock>
                                    </StackPanel>
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </DockPanel>
    </Border>
</UserControl>

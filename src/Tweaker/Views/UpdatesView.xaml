<UserControl x:Class="Tweaker.Views.UpdatesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:conv="clr-namespace:Tweaker.Converters">
    <UserControl.Resources>
        <conv:EnumEqualsMultiConverter x:Key="EnumEq" />
        <conv:BoolToVisibilityConverter x:Key="BoolToVis" />
    </UserControl.Resources>
    <ScrollViewer Style="{StaticResource ThemedScroll}" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="28,24" MaxWidth="680" HorizontalAlignment="Left">
            <TextBlock Text="Windows Update" Foreground="{StaticResource TextActive}" FontSize="15" FontWeight="SemiBold" />
            <TextBlock Text="Control how Windows receives updates. Applies via policy + registry." Foreground="{StaticResource TextDim}"
                       FontSize="12" Margin="0,3,0,18" />

            <ItemsControl ItemsSource="{Binding Presets}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <RadioButton GroupName="preset" Margin="0,0,0,8" Checked="Preset_Checked">
                            <RadioButton.IsChecked>
                                <MultiBinding Converter="{StaticResource EnumEq}" Mode="OneWay">
                                    <Binding Path="DataContext.SelectedPreset" RelativeSource="{RelativeSource AncestorType=ItemsControl}" />
                                    <Binding Path="Value" />
                                </MultiBinding>
                            </RadioButton.IsChecked>
                            <RadioButton.Template>
                                <ControlTemplate TargetType="RadioButton">
                                    <Border x:Name="b" Background="{StaticResource BgCard}" BorderBrush="{StaticResource BorderCard}"
                                            BorderThickness="1" CornerRadius="4" Padding="14,12" Cursor="Hand">
                                        <StackPanel>
                                            <TextBlock Text="{Binding Label}" Foreground="{StaticResource TextName}" FontSize="13" FontWeight="Medium" />
                                            <TextBlock Text="{Binding Description}" Foreground="{StaticResource TextFaint}" FontSize="11" Margin="0,2,0,0" />
                                        </StackPanel>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsChecked" Value="True">
                                            <Setter TargetName="b" Property="Background" Value="{StaticResource RowApplied}" />
                                            <Setter TargetName="b" Property="BorderBrush" Value="{StaticResource AccentBorder}" />
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </RadioButton.Template>
                        </RadioButton>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <Border Background="{StaticResource BgCard}" BorderBrush="{StaticResource BorderCard}" BorderThickness="1"
                    CornerRadius="4" Padding="14,12" Margin="0,10,0,0">
                <StackPanel>
                    <TextBlock Text="WHAT THIS DOES" Style="{StaticResource Label10}" Margin="0,0,0,8" />
                    <ItemsControl ItemsSource="{Binding SelectedRow.Details}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding StringFormat='•  {0}'}" Foreground="{StaticResource TextMuted}"
                                           FontSize="12" Margin="0,0,0,4" TextWrapping="Wrap" />
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>

            <Border Background="#1C0E0E" BorderBrush="#3A1A1A" BorderThickness="1" CornerRadius="4" Padding="12,10" Margin="0,8,0,0"
                    Visibility="{Binding ShowWarning, Converter={StaticResource BoolToVis}}">
                <TextBlock Text="Warning: Disabling all updates leaves your system without security patches. Use with caution."
                           Foreground="#8A4A4A" FontSize="12" TextWrapping="Wrap" />
            </Border>

            <StackPanel Orientation="Horizontal" Margin="0,16,0,0" VerticalAlignment="Center">
                <Button Content="Apply" Style="{StaticResource AccentButton}" Command="{Binding ApplyCommand}" Margin="0,0,10,0" />
                <TextBlock Text="{Binding ActiveLabel}" FontFamily="{StaticResource MonoFont}" Foreground="#5A8A5A" FontSize="12" VerticalAlignment="Center" />
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</UserControl>

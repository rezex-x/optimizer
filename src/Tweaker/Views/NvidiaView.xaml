<UserControl x:Class="Tweaker.Views.NvidiaView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:conv="clr-namespace:Tweaker.Converters">
    <UserControl.Resources>
        <conv:UpperCaseConverter x:Key="Upper" />
        <conv:RiskBadgeConverter x:Key="RiskBadge" />
    </UserControl.Resources>
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="140" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0" BorderBrush="{StaticResource BorderSubtle}" BorderThickness="0,0,1,0">
            <DockPanel>
                <TextBlock DockPanel.Dock="Top" Text="CATEGORY" Style="{StaticResource Label10}"
                           Foreground="{StaticResource TextFaint}" Margin="14,16,12,6" />
                <ListBox Style="{StaticResource NavList}" ItemsSource="{Binding Categories}"
                         SelectedItem="{Binding SelectedCategory, Mode=TwoWay}" />
            </DockPanel>
        </Border>

        <DockPanel Grid.Column="1">
            <Border DockPanel.Dock="Top">
                <Border.Style>
                    <Style TargetType="Border" BasedOn="{StaticResource ToolbarBorder}">
                        <Setter Property="Background" Value="Transparent" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsAvailable}" Value="False">
                                <Setter Property="Background" Value="#1C0E0E" />
                                <Setter Property="BorderBrush" Value="#3A1A1A" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <DockPanel>
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button Content="Create Restore Point" Style="{StaticResource RestorePointButton}" Margin="0,0,8,0"
                                Click="RestorePointButton_Click" />
                        <Button Content="Apply Recommended FPS" Style="{StaticResource AccentButton}"
                                Command="{Binding ApplyRecommendedCommand}" IsEnabled="{Binding IsAvailable}" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Ellipse Width="6" Height="6" Margin="0,0,8,0" VerticalAlignment="Center">
                            <Ellipse.Style>
                                <Style TargetType="Ellipse">
                                    <Setter Property="Fill" Value="{StaticResource AccentText}" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsAvailable}" Value="False">
                                            <Setter Property="Fill" Value="#C05A5A" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Ellipse.Style>
                        </Ellipse>
                        <TextBlock Text="{Binding GpuStatus}" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center"
                                   TextTrimming="CharacterEllipsis">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Foreground" Value="{StaticResource TextActive}" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsAvailable}" Value="False">
                                            <Setter Property="Foreground" Value="#C05A5A" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </StackPanel>
                </DockPanel>
            </Border>

            <ScrollViewer Style="{StaticResource ThemedScroll}" HorizontalScrollBarVisibility="Disabled" Padding="10,6,10,10">
                <StackPanel IsEnabled="{Binding IsAvailable}">
                    <ItemsControl ItemsSource="{Binding Groups}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Margin="8,10,8,4">
                                    <TextBlock Text="{Binding Name, Converter={StaticResource Upper}}" Style="{StaticResource SectionHeader}"
                                               Margin="4,0,0,10" />
                                    <Border Background="{StaticResource BgCard}" BorderBrush="{StaticResource BorderCard}" BorderThickness="1" CornerRadius="4">
                                        <ItemsControl ItemsSource="{Binding Settings}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Border BorderBrush="{StaticResource RowDivider}" BorderThickness="0,0,0,1" Padding="14,11">
                                                        <Border.Style>
                                                            <Style TargetType="Border">
                                                                <Setter Property="Background" Value="Transparent" />
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding IsApplied}" Value="True">
                                                                        <Setter Property="Background" Value="{StaticResource RowApplied}" />
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </Border.Style>
                                                        <Grid>
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="Auto" />
                                                                <ColumnDefinition Width="*" />
                                                                <ColumnDefinition Width="Auto" />
                                                            </Grid.ColumnDefinitions>
                                                            <CheckBox Grid.Column="0" Style="{StaticResource PillToggle}" VerticalAlignment="Center" Margin="0,0,14,0"
                                                                      IsChecked="{Binding IsSwitchOn, Mode=OneWay}" Command="{Binding ToggleCommand}"
                                                                      IsEnabled="{Binding CanEdit}" />
                                                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                                <StackPanel Orientation="Horizontal">
                                                                    <TextBlock Text="{Binding Name}" FontSize="13" VerticalAlignment="Center">
                                                                        <TextBlock.Style>
                                                                            <Style TargetType="TextBlock">
                                                                                <Setter Property="Foreground" Value="{StaticResource TextName}" />
                                                                                <Style.Triggers>
                                                                                    <DataTrigger Binding="{Binding IsApplied}" Value="True">
                                                                                        <Setter Property="Foreground" Value="{StaticResource TextActive}" />
                                                                                    </DataTrigger>
                                                                                </Style.Triggers>
                                                                            </Style>
                                                                        </TextBlock.Style>
                                                                    </TextBlock>
                                                                    <Border CornerRadius="2" Padding="5,1" Margin="8,0,0,0" VerticalAlignment="Center" BorderThickness="1"
                                                                            Background="{Binding Risk, Converter={StaticResource RiskBadge}, ConverterParameter=bg}"
                                                                            BorderBrush="{Binding Risk, Converter={StaticResource RiskBadge}, ConverterParameter=border}">
                                                                        <TextBlock Text="{Binding Risk, Converter={StaticResource Upper}}" FontSize="9"
                                                                                   Foreground="{Binding Risk, Converter={StaticResource RiskBadge}, ConverterParameter=fg}" />
                                                                    </Border>
                                                                </StackPanel>
                                                                <TextBlock Text="{Binding Description}" Foreground="{StaticResource TextBody}" FontSize="11"
                                                                           TextWrapping="Wrap" Margin="0,4,12,0" />
                                                                <TextBlock TextWrapping="Wrap" Margin="0,3,12,0" FontSize="11" Foreground="{StaticResource TextBody}">
                                                                    <Run Text="Downsides: " FontWeight="SemiBold" Foreground="{StaticResource TextDim}" />
                                                                    <Run Text="{Binding Downsides, Mode=OneWay}" />
                                                                </TextBlock>
                                                            </StackPanel>
                                                            <TextBlock Grid.Column="2" Text="{Binding StatusText}" Style="{StaticResource RowStatusText}" Margin="12,0,0,0" />
                                                        </Grid>
                                                    </Border>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </Border>
                                </StackPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </ScrollViewer>
        </DockPanel>
    </Grid>
</UserControl>

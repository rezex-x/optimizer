<UserControl x:Class="Tweaker.Views.ProfilesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:Tweaker.Controls"
             xmlns:conv="clr-namespace:Tweaker.Converters">
    <UserControl.Resources>
        <conv:BoolToVisibilityConverter x:Key="BoolToVis" />
        <Style x:Key="ProfileCard" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource BgCard}" />
            <Setter Property="BorderBrush" Value="{StaticResource BorderCard}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="4" />
        </Style>
        <Style x:Key="SegGroup" TargetType="Border">
            <Setter Property="BorderBrush" Value="{StaticResource BorderInput}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="3" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style x:Key="SettingText" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Foreground" Value="{StaticResource TextMuted}" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style x:Key="ProfileNavItem" TargetType="ListBoxItem">
            <Setter Property="FontFamily" Value="{StaticResource AppFont}" />
            <Setter Property="Foreground" Value="{StaticResource TextMuted}" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="b" Background="Transparent" BorderThickness="2,0,0,0" BorderBrush="Transparent" Padding="12,8">
                            <ContentPresenter />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="b" Property="Background" Value="{StaticResource BgNavActive}" />
                                <Setter TargetName="b" Property="BorderBrush" Value="{StaticResource NavAccent}" />
                                <Setter Property="Foreground" Value="{StaticResource TextActive}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="EntryRow" TargetType="Border">
            <Setter Property="BorderBrush" Value="{StaticResource RowDivider}" />
            <Setter Property="BorderThickness" Value="0,0,0,1" />
            <Setter Property="Padding" Value="13,7,8,7" />
        </Style>
    </UserControl.Resources>

    <DockPanel>
        <Border DockPanel.Dock="Left" Width="220" BorderBrush="{StaticResource BorderSubtle}" BorderThickness="0,0,1,0">
            <DockPanel>
                <Border DockPanel.Dock="Top" Padding="12,10,12,8" BorderBrush="{StaticResource RowDivider}" BorderThickness="0,0,0,1">
                    <DockPanel>
                        <Button DockPanel.Dock="Right" Content="+ New" Style="{StaticResource GhostButtonSm}" Command="{Binding NewCommand}" />
                        <TextBlock Text="PROFILES" Style="{StaticResource Label10}" VerticalAlignment="Center" />
                    </DockPanel>
                </Border>
                <ListBox ItemsSource="{Binding Items}" SelectedItem="{Binding Selected, Mode=TwoWay}" Background="Transparent"
                         BorderThickness="0" Padding="0,6,0,0" ItemContainerStyle="{StaticResource ProfileNavItem}"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <StackPanel>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="{Binding Name}" FontSize="12" TextTrimming="CharacterEllipsis" MaxWidth="170" />
                                    <Ellipse Width="5" Height="5" Fill="{StaticResource AccentText}" Margin="6,0,0,0" VerticalAlignment="Center"
                                             Visibility="{Binding IsActive, Converter={StaticResource BoolToVis}}" />
                                </StackPanel>
                                <WrapPanel Margin="0,4,0,0">
                                    <controls:Badge Text="AUTO" Tone="Low" Margin="0,0,4,0"
                                                    Visibility="{Binding ShowAuto, Converter={StaticResource BoolToVis}}" />
                                    <controls:Badge Text="CUSTOM" Tone="Purple" Margin="0,0,4,0"
                                                    Visibility="{Binding ShowCustom, Converter={StaticResource BoolToVis}}" />
                                    <controls:Badge Text="{Binding ModeText}" Tone="Neutral" />
                                </WrapPanel>
                            </StackPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </DockPanel>
        </Border>

        <ScrollViewer Style="{StaticResource ThemedScroll}" HorizontalScrollBarVisibility="Disabled"
                      Visibility="{Binding HasSelection, Converter={StaticResource BoolToVis}}">
            <StackPanel Margin="20,18,20,18">
                <DockPanel>
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Top" Margin="12,0,0,0">
                        <Button Content="Delete" Style="{StaticResource DangerButtonSm}" Command="{Binding DeleteCommand}" Margin="0,0,8,0"
                                Visibility="{Binding ShowDelete, Converter={StaticResource BoolToVis}}" />
                        <Button Content="Confirm delete" Style="{StaticResource DangerButtonSm}" Command="{Binding ConfirmDeleteCommand}" Margin="0,0,8,0"
                                Visibility="{Binding ShowConfirmDelete, Converter={StaticResource BoolToVis}}" />
                        <Button Content="Activate now" Style="{StaticResource AccentButton}" Command="{Binding ActivateCommand}"
                                IsEnabled="{Binding CanActivate}"
                                Visibility="{Binding ShowActivate, Converter={StaticResource BoolToVis}}" />
                        <Button Content="Deactivate" Style="{StaticResource GhostButton}" Command="{Binding DeactivateCommand}"
                                Visibility="{Binding ShowDeactivate, Converter={StaticResource BoolToVis}}" />
                    </StackPanel>
                    <StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <TextBox Text="{Binding Name}" Style="{StaticResource InputBox}" FontSize="15" FontWeight="SemiBold" MinWidth="240" />
                            <controls:Badge Text="ACTIVE" Tone="Low" Margin="10,0,0,0" VerticalAlignment="Center"
                                            Visibility="{Binding IsSelectedActive, Converter={StaticResource BoolToVis}}" />
                        </StackPanel>
                        <TextBox Text="{Binding Description}" Style="{StaticResource InputBox}" Margin="0,6,0,0" FontSize="12" />
                    </StackPanel>
                </DockPanel>
                <TextBlock Text="{Binding Message}" FontSize="11" Foreground="{StaticResource TextDim}" TextWrapping="Wrap" Margin="0,8,0,12" />

                <Border Background="{StaticResource DangerBg}" BorderBrush="{StaticResource DangerBorder}" BorderThickness="1" CornerRadius="4"
                        Padding="12,10" Margin="0,0,0,14" Visibility="{Binding IsPreviewing, Converter={StaticResource BoolToVis}}">
                    <StackPanel>
                        <TextBlock Text="{Binding PreviewTitle}" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource TextActive}" />
                        <StackPanel Margin="0,6,0,0" Visibility="{Binding HasPreviewItems, Converter={StaticResource BoolToVis}}">
                            <TextBlock FontSize="11" Foreground="{StaticResource TextMuted}" TextWrapping="Wrap">
                                <Run Text="Close: " Foreground="{StaticResource TextDim}" /><Run Text="{Binding PreviewCloseText, Mode=OneWay}" />
                            </TextBlock>
                            <TextBlock FontSize="11" Foreground="{StaticResource TextMuted}" TextWrapping="Wrap" Margin="0,3,0,0">
                                <Run Text="Stop: " Foreground="{StaticResource TextDim}" /><Run Text="{Binding PreviewStopText, Mode=OneWay}" />
                            </TextBlock>
                        </StackPanel>
                        <TextBlock Text="Nothing to close or stop right now." FontSize="11" Foreground="{StaticResource TextMuted}" Margin="0,6,0,0"
                                   Visibility="{Binding IsPreviewEmpty, Converter={StaticResource BoolToVis}}" />
                        <TextBlock FontSize="10" Foreground="{StaticResource TextFaint}" TextWrapping="Wrap" Margin="0,6,0,0"
                                   Text="Apps with a window are asked to close, so they can ask to save. Background apps are ended. Services restart when you deactivate." />
                        <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                            <Button Content="Confirm" Style="{StaticResource DangerButtonSm}" Command="{Binding ConfirmActivateCommand}" />
                            <Button Content="Cancel" Style="{StaticResource GhostButtonSm}" Command="{Binding CancelPreviewCommand}" Margin="8,0,0,0" />
                        </StackPanel>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource ProfileCard}" Padding="14,0" Margin="0,0,0,14">
                    <StackPanel>
                        <Border BorderBrush="{StaticResource RowDivider}" BorderThickness="0,0,0,1" Padding="0,9">
                            <DockPanel>
                                <TextBlock Text="When this starts" Style="{StaticResource SettingText}" Width="150" />
                                <Button DockPanel.Dock="Right" Content="Browse…" Style="{StaticResource GhostButtonSm}" Click="Browse_Click" Margin="8,0,0,0" />
                                <Grid>
                                    <TextBox Text="{Binding Trigger}" Style="{StaticResource MonoInputBox}" KeyDown="TriggerBox_KeyDown" />
                                    <TextBlock Text="Manual only — type or browse for the game's exe" FontSize="11" Foreground="{StaticResource TextFaint}"
                                               Margin="9,0,0,0" VerticalAlignment="Center" IsHitTestVisible="False">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding Trigger}" Value="">
                                                        <Setter Property="Visibility" Value="Visible" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </Grid>
                            </DockPanel>
                        </Border>
                        <Border BorderBrush="{StaticResource RowDivider}" BorderThickness="0,0,0,1" Padding="0,9">
                            <StackPanel>
                                <DockPanel>
                                    <CheckBox DockPanel.Dock="Right" Style="{StaticResource PillToggle}" IsChecked="{Binding AutoActivate}"
                                              IsEnabled="{Binding CanAutoActivate}" />
                                    <TextBlock Text="Activate automatically when the game starts" Style="{StaticResource SettingText}" />
                                </DockPanel>
                                <TextBlock Text="Runs without a preview: apps close as soon as the game starts. Close-list profiles only."
                                           FontSize="10" Foreground="{StaticResource TextFaint}" TextWrapping="Wrap" Margin="0,4,0,0" />
                            </StackPanel>
                        </Border>
                        <DockPanel Margin="0,9">
                            <CheckBox DockPanel.Dock="Right" Style="{StaticResource PillToggle}" IsChecked="{Binding RestoreServices}" />
                            <TextBlock Text="Restart stopped services when the game exits" Style="{StaticResource SettingText}" />
                        </DockPanel>
                    </StackPanel>
                </Border>

                <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                    <TextBlock Text="MODE" Style="{StaticResource Label10}" VerticalAlignment="Center" Margin="0,0,10,0" />
                    <Border Style="{StaticResource SegGroup}">
                        <StackPanel Orientation="Horizontal">
                            <Button Content="Close these apps" Command="{Binding SetModeCommand}" CommandParameter="CloseList"
                                    Tag="{Binding IsCloseList}" Style="{StaticResource SegmentedButton}" />
                            <Button Content="Only allow these apps" Command="{Binding SetModeCommand}" CommandParameter="AllowList"
                                    Tag="{Binding IsAllowList}" Style="{StaticResource SegmentedButton}" BorderThickness="1,0,0,0" />
                        </StackPanel>
                    </Border>
                </StackPanel>
                <Border Background="{StaticResource ToneInfoBg}" BorderBrush="{StaticResource ToneInfoBorder}" BorderThickness="1" CornerRadius="4"
                        Padding="12,9" Margin="0,0,0,14" Visibility="{Binding IsAllowList, Converter={StaticResource BoolToVis}}">
                    <TextBlock Text="{Binding AllowNote}" FontSize="11" Foreground="{StaticResource ToneInfoFg}" TextWrapping="Wrap" />
                </Border>

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="14" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0">
                        <TextBlock Text="{Binding AppsTitle}" Style="{StaticResource Label10}" Margin="0,0,0,8" />
                        <Border Style="{StaticResource ProfileCard}">
                            <StackPanel>
                                <ItemsControl ItemsSource="{Binding Apps}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Style="{StaticResource EntryRow}">
                                                <DockPanel>
                                                    <Button DockPanel.Dock="Right" Content="×" Style="{StaticResource GhostButtonSm}" ToolTip="Remove"
                                                            Command="{Binding DataContext.RemoveAppCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                            CommandParameter="{Binding}" />
                                                    <Ellipse x:Name="Dot" Width="5" Height="5" Fill="{StaticResource DangerText}" Margin="0,0,9,0" VerticalAlignment="Center" />
                                                    <TextBlock Text="{Binding Text}" FontFamily="{StaticResource MonoFont}" FontSize="11"
                                                               Foreground="{StaticResource TextName}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                                </DockPanel>
                                            </Border>
                                            <DataTemplate.Triggers>
                                                <DataTrigger Binding="{Binding DataContext.IsAllowList, RelativeSource={RelativeSource AncestorType=UserControl}}" Value="True">
                                                    <Setter TargetName="Dot" Property="Fill" Value="{StaticResource AccentText}" />
                                                </DataTrigger>
                                            </DataTemplate.Triggers>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <DockPanel Margin="13,7,8,7">
                                    <Button DockPanel.Dock="Right" Content="Add" Style="{StaticResource GhostButtonSm}" Command="{Binding AddAppCommand}" Margin="8,0,0,0" />
                                    <Grid>
                                        <TextBox Text="{Binding NewApp, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource MonoInputBox}">
                                            <TextBox.InputBindings>
                                                <KeyBinding Key="Return" Command="{Binding AddAppCommand}" />
                                            </TextBox.InputBindings>
                                        </TextBox>
                                        <TextBlock Text="+ Add app (e.g. Discord.exe)" FontSize="11" Foreground="{StaticResource TextFaint}"
                                                   Margin="9,0,0,0" VerticalAlignment="Center" IsHitTestVisible="False">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding NewApp}" Value="">
                                                            <Setter Property="Visibility" Value="Visible" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </Grid>
                                </DockPanel>
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <StackPanel Grid.Column="2">
                        <TextBlock Text="{Binding ServicesTitle}" Style="{StaticResource Label10}" Margin="0,0,0,8" />
                        <Border Style="{StaticResource ProfileCard}">
                            <StackPanel>
                                <ItemsControl ItemsSource="{Binding Services}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Style="{StaticResource EntryRow}">
                                                <DockPanel>
                                                    <Button DockPanel.Dock="Right" Content="×" Style="{StaticResource GhostButtonSm}" ToolTip="Remove"
                                                            Command="{Binding DataContext.RemoveServiceCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                            CommandParameter="{Binding}" />
                                                    <Ellipse Width="5" Height="5" Fill="{StaticResource LevelWarm}" Margin="0,0,9,0" VerticalAlignment="Center" />
                                                    <StackPanel VerticalAlignment="Center">
                                                        <TextBlock Text="{Binding Text}" FontSize="11" Foreground="{StaticResource TextName}" TextTrimming="CharacterEllipsis" />
                                                        <TextBlock Text="{Binding Detail}" FontFamily="{StaticResource MonoFont}" FontSize="10"
                                                                   Foreground="{StaticResource TextFaint}" Margin="0,1,0,0"
                                                                   Visibility="{Binding HasDetail, Converter={StaticResource BoolToVis}}" />
                                                    </StackPanel>
                                                </DockPanel>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <DockPanel Margin="13,7,8,7">
                                    <Button DockPanel.Dock="Right" Content="Add" Style="{StaticResource GhostButtonSm}" Command="{Binding AddServiceCommand}" Margin="8,0,0,0" />
                                    <Grid>
                                        <TextBox Text="{Binding NewService, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource InputBox}">
                                            <TextBox.InputBindings>
                                                <KeyBinding Key="Return" Command="{Binding AddServiceCommand}" />
                                            </TextBox.InputBindings>
                                        </TextBox>
                                        <TextBlock Text="+ Add service (name or display name)" FontSize="11" Foreground="{StaticResource TextFaint}"
                                                   Margin="9,0,0,0" VerticalAlignment="Center" IsHitTestVisible="False">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding NewService}" Value="">
                                                            <Setter Property="Visibility" Value="Visible" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </Grid>
                                </DockPanel>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Grid>

                <TextBlock FontSize="10" Foreground="{StaticResource TextFaint}" TextWrapping="Wrap" Margin="0,14,0,0"
                           Text="A profile only closes your own apps. Windows, protected processes (security software, anti-cheat, this app) and the game itself are never touched, and protected services are never stopped. Only one profile is active at a time." />
            </StackPanel>
        </ScrollViewer>
    </DockPanel>
</UserControl>

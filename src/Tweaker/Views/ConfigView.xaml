<UserControl x:Class="Tweaker.Views.ConfigView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:conv="clr-namespace:Tweaker.Converters">
    <UserControl.Resources>
        <conv:UpperCaseConverter x:Key="Upper" />

        <DataTemplate x:Key="ConfigGroupCard">
            <StackPanel Margin="8,10,8,4">
                <TextBlock Text="{Binding Name, Converter={StaticResource Upper}}" Style="{StaticResource SectionHeader}"
                           Margin="4,0,0,10" />
                <Border Background="{StaticResource BgCard}" BorderBrush="{StaticResource BorderCard}" BorderThickness="1" CornerRadius="4">
                    <ItemsControl ItemsSource="{Binding Tweaks}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border BorderBrush="{StaticResource RowDivider}" BorderThickness="0,0,0,1" Padding="12,10">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Setter Property="Background" Value="Transparent" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsApplied}" Value="True">
                                                    <Setter Property="Background" Value="{StaticResource RowApplied}" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <CheckBox Grid.Column="0" Style="{StaticResource PillToggle}" VerticalAlignment="Center" Margin="0,0,12,0"
                                                  IsChecked="{Binding IsSwitchOn, Mode=OneWay}" Command="{Binding ToggleCommand}"
                                                  IsEnabled="{Binding CanToggle}" />
                                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Name}" FontSize="12">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Foreground" Value="{StaticResource TextName}" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsApplied}" Value="True">
                                                                <Setter Property="Foreground" Value="{StaticResource TextActive}" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                            <TextBlock Text="{Binding Description}" Foreground="{StaticResource TextBody}" FontSize="11"
                                                       TextWrapping="Wrap" Margin="0,1,8,0" />
                                        </StackPanel>
                                        <TextBlock Grid.Column="2" Text="{Binding StatusText}" Style="{StaticResource RowStatusText}" Margin="8,0,0,0" />
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </Border>
            </StackPanel>
        </DataTemplate>
    </UserControl.Resources>
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="140" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0" BorderBrush="{StaticResource BorderSubtle}" BorderThickness="0,0,1,0">
            <DockPanel>
                <TextBlock DockPanel.Dock="Top" Text="CATEGORY" Style="{StaticResource Label10}"
                           Foreground="{StaticResource TextFaint}" Margin="14,16,12,6" />
                <ListBox Style="{StaticResource NavList}" ItemsSource="{Binding Categories}"
                         SelectedItem="{Binding SelectedCategory, Mode=TwoWay}" />
            </DockPanel>
        </Border>

        <DockPanel Grid.Column="1">
            <Border DockPanel.Dock="Top" Style="{StaticResource ToolbarBorder}">
                <DockPanel>
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="{Binding AppliedCount, StringFormat={}{0} applied}" Foreground="{StaticResource TextDim}"
                                   FontSize="11" VerticalAlignment="Center" Margin="0,0,10,0" />
                        <Button Content="Create Restore Point" Style="{StaticResource RestorePointButton}" Click="RestorePointButton_Click" />
                    </StackPanel>
                    <Grid Margin="0,0,12,0" VerticalAlignment="Center">
                        <TextBox Style="{StaticResource InputBox}" Padding="26,5,8,5"
                                 Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" />
                        <Canvas Width="12" Height="12" HorizontalAlignment="Left" Margin="8,0,0,0" VerticalAlignment="Center"
                                IsHitTestVisible="False">
                            <Ellipse Canvas.Left="1" Canvas.Top="1" Width="8" Height="8"
                                     Stroke="{StaticResource TextFaint}" StrokeThickness="1.2" />
                            <Line X1="8" Y1="8" X2="11.5" Y2="11.5" Stroke="{StaticResource TextFaint}"
                                  StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeThickness="1.2" />
                        </Canvas>
                        <TextBlock Text="Search settings…" Foreground="{StaticResource TextFaint}" FontSize="12"
                                   Margin="29,0,0,0" VerticalAlignment="Center" IsHitTestVisible="False">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding SearchText}" Value="">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </Grid>
                </DockPanel>
            </Border>

            <ScrollViewer Style="{StaticResource ThemedScroll}" HorizontalScrollBarVisibility="Disabled" Padding="10,6,10,10">
                <ItemsControl ItemsSource="{Binding Groups}" ItemTemplate="{StaticResource ConfigGroupCard}" />
            </ScrollViewer>
        </DockPanel>
    </Grid>
</UserControl>

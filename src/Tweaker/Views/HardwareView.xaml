<UserControl x:Class="Tweaker.Views.HardwareView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib"
             xmlns:controls="clr-namespace:Tweaker.Controls"
             xmlns:conv="clr-namespace:Tweaker.Converters">
    <UserControl.Resources>
        <conv:BoolToVisibilityConverter x:Key="BoolToVis" />
        <Style x:Key="HwCard" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource BgCard}" />
            <Setter Property="BorderBrush" Value="{StaticResource BorderCard}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="4" />
        </Style>
        <Style x:Key="KvLine" TargetType="Border">
            <Setter Property="BorderBrush" Value="{StaticResource RowDivider}" />
            <Setter Property="BorderThickness" Value="0,0,0,1" />
            <Setter Property="Padding" Value="0,6" />
        </Style>
        <Style x:Key="SegGroup" TargetType="Border">
            <Setter Property="BorderBrush" Value="{StaticResource BorderInput}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="3" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style x:Key="ClassButton" TargetType="Button">
            <Setter Property="FontFamily" Value="{StaticResource AppFont}" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Foreground" Value="{StaticResource TextDim}" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="b" Background="Transparent" BorderThickness="2,0,0,0" BorderBrush="Transparent" Padding="10,6">
                            <ContentPresenter />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Foreground" Value="{StaticResource TextMuted}" />
                            </Trigger>
                            <Trigger Property="Tag">
                                <Trigger.Value><sys:Boolean>True</sys:Boolean></Trigger.Value>
                                <Setter TargetName="b" Property="Background" Value="{StaticResource BgNavActive}" />
                                <Setter TargetName="b" Property="BorderBrush" Value="{StaticResource NavAccent}" />
                                <Setter Property="Foreground" Value="{StaticResource TextActive}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <DockPanel>
        <Border DockPanel.Dock="Left" Width="150" BorderBrush="{StaticResource BorderSubtle}" BorderThickness="0,0,1,0">
            <DockPanel>
                <TextBlock DockPanel.Dock="Top" Text="DEVICE CLASS" Style="{StaticResource Label10}" Margin="12,12,12,8" />
                <ScrollViewer Style="{StaticResource ThemedScroll}" HorizontalScrollBarVisibility="Disabled">
                    <ItemsControl ItemsSource="{Binding Classes}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Button Style="{StaticResource ClassButton}" Tag="{Binding IsActive}"
                                        Command="{Binding DataContext.SelectClassCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                        CommandParameter="{Binding Name}">
                                    <DockPanel>
                                        <TextBlock DockPanel.Dock="Right" Text="{Binding Count}" FontFamily="{StaticResource MonoFont}" FontSize="10"
                                                   Foreground="{StaticResource TextFaint}" VerticalAlignment="Center" />
                                        <TextBlock Text="{Binding Name}" />
                                    </DockPanel>
                                </Button>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </DockPanel>
        </Border>

        <Border DockPanel.Dock="Top" Style="{StaticResource ToolbarBorder}">
            <DockPanel>
                <TextBlock DockPanel.Dock="Right" Text="{Binding Message}" FontSize="11" Foreground="{StaticResource TextDim}"
                           VerticalAlignment="Center" TextTrimming="CharacterEllipsis" MaxWidth="340" Margin="12,0,0,0" />
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Grid Width="190" Margin="0,0,10,0" VerticalAlignment="Center">
                        <TextBox Style="{StaticResource InputBox}" Padding="26,4,8,4"
                                 Text="{Binding Filter, UpdateSourceTrigger=PropertyChanged, Delay=200}" />
                        <Canvas Width="12" Height="12" HorizontalAlignment="Left" Margin="8,0,0,0" VerticalAlignment="Center"
                                IsHitTestVisible="False">
                            <Ellipse Canvas.Left="1" Canvas.Top="1" Width="8" Height="8"
                                     Stroke="{StaticResource TextFaint}" StrokeThickness="1.2" />
                            <Line X1="8" Y1="8" X2="11.5" Y2="11.5" Stroke="{StaticResource TextFaint}"
                                  StrokeThickness="1.2" StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
                        </Canvas>
                        <TextBlock Text="Search devices…" Foreground="{StaticResource TextFaint}" FontSize="12"
                                   Margin="29,0,0,0" VerticalAlignment="Center" IsHitTestVisible="False">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Filter}" Value="">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </Grid>
                    <TextBlock Text="Power saving" FontSize="11" Foreground="{StaticResource TextDim}" Margin="0,0,6,0" VerticalAlignment="Center" />
                    <Border Style="{StaticResource SegGroup}">
                        <StackPanel Orientation="Horizontal">
                            <Button Content="All" Command="{Binding SetPowerFilterCommand}" CommandParameter="All"
                                    Tag="{Binding IsPowerAll}" Style="{StaticResource SegmentedButton}" />
                            <Button Content="On" Command="{Binding SetPowerFilterCommand}" CommandParameter="On"
                                    Tag="{Binding IsPowerOn}" Style="{StaticResource SegmentedButton}" BorderThickness="1,0,0,0" />
                            <Button Content="Off" Command="{Binding SetPowerFilterCommand}" CommandParameter="Off"
                                    Tag="{Binding IsPowerOff}" Style="{StaticResource SegmentedButton}" BorderThickness="1,0,0,0" />
                        </StackPanel>
                    </Border>
                    <Button Content="Turn off USB / input power saving" Style="{StaticResource AccentButton}" Margin="10,0,0,0"
                            Command="{Binding TurnOffCommand}" Visibility="{Binding ShowTurnOff, Converter={StaticResource BoolToVis}}" />
                    <Button Content="Confirm" Style="{StaticResource DangerButtonSm}" Padding="14,6" FontSize="12" Margin="10,0,0,0" VerticalAlignment="Center"
                            Command="{Binding ConfirmTurnOffCommand}" Visibility="{Binding ShowConfirmTurnOff, Converter={StaticResource BoolToVis}}" />
                    <Button Content="{Binding RevertText}" Style="{StaticResource GhostButtonSm}" Margin="8,0,0,0" VerticalAlignment="Center"
                            Command="{Binding RevertCommand}" Visibility="{Binding ShowRevert, Converter={StaticResource BoolToVis}}" />
                </StackPanel>
            </DockPanel>
        </Border>

        <Border DockPanel.Dock="Right" Width="340" Background="{StaticResource BgPanel}" BorderBrush="{StaticResource BorderSubtle}"
                BorderThickness="1,0,0,0"
                Visibility="{Binding Advanced.IsOpen, Converter={StaticResource BoolToVis}, FallbackValue=Collapsed}">
            <DockPanel DataContext="{Binding Advanced}">
                <Border DockPanel.Dock="Top" Padding="14,12" BorderBrush="{StaticResource RowDivider}" BorderThickness="0,0,0,1">
                    <StackPanel>
                        <DockPanel>
                            <Button DockPanel.Dock="Right" Content="×" Style="{StaticResource GhostButtonSm}" Command="{Binding CloseCommand}"
                                    ToolTip="Close" VerticalAlignment="Top" />
                            <TextBlock Text="{Binding DeviceName}" FontSize="13" Foreground="{StaticResource TextName}" TextWrapping="Wrap" />
                        </DockPanel>
                        <TextBlock Text="{Binding Message}" FontSize="11" Foreground="{StaticResource TextDim}" TextWrapping="Wrap" Margin="0,6,0,0" />
                    </StackPanel>
                </Border>
                <Button DockPanel.Dock="Bottom" Content="Revert this device" Style="{StaticResource GhostButton}" Margin="14,10"
                        Command="{Binding RevertCommand}" Visibility="{Binding CanRevert, Converter={StaticResource BoolToVis}}" />
                <ScrollViewer Style="{StaticResource ThemedScroll}" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel Margin="14,10">
                        <TextBlock Text="{Binding InterruptNote}" FontSize="11" Foreground="{StaticResource TextDim}" TextWrapping="Wrap"
                                   Visibility="{Binding HasInterruptNote, Converter={StaticResource BoolToVis}}" />
                        <StackPanel Visibility="{Binding ShowInterrupts, Converter={StaticResource BoolToVis}}">
                            <TextBlock Text="INTERRUPTS" Style="{StaticResource Label10}" Margin="0,4,0,8" />
                            <TextBlock Text="Message-signaled interrupts" FontSize="12" Foreground="{StaticResource TextMuted}" />
                            <ComboBox Style="{StaticResource DarkCombo}" ItemsSource="{Binding MsiOptions}" SelectedItem="{Binding SelectedMsi}"
                                      Margin="0,4,0,10" />
                            <TextBlock Text="Interrupt affinity" FontSize="12" Foreground="{StaticResource TextMuted}" />
                            <ComboBox Style="{StaticResource DarkCombo}" ItemsSource="{Binding AffinityOptions}" SelectedItem="{Binding SelectedAffinity}"
                                      DisplayMemberPath="Label" Margin="0,4,0,8" />
                            <TextBlock FontSize="10" Foreground="{StaticResource TextFaint}" TextWrapping="Wrap"
                                       Text="Takes effect after a restart. Most drivers already turn MSI on — if it shows On, leave it. Audio controllers benefit most. A wrong CPU pin can raise latency — measure before and after." />
                        </StackPanel>
                        <StackPanel Margin="0,14,0,0" Visibility="{Binding ShowNic, Converter={StaticResource BoolToVis}}">
                            <TextBlock Text="ADAPTER PROPERTIES" Style="{StaticResource Label10}" Margin="0,4,0,8" />
                            <TextBlock Text="Reading adapter properties…" FontSize="11" Foreground="{StaticResource TextDim}"
                                       Visibility="{Binding IsLoadingNic, Converter={StaticResource BoolToVis}}" />
                            <TextBlock Text="{Binding NicNote}" FontSize="11" Foreground="{StaticResource TextDim}" TextWrapping="Wrap"
                                       Visibility="{Binding HasNicNote, Converter={StaticResource BoolToVis}}" />
                            <ItemsControl ItemsSource="{Binding NicProperties}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel Margin="0,0,0,10">
                                            <TextBlock Text="{Binding DisplayName}" FontSize="12" Foreground="{StaticResource TextMuted}" TextWrapping="Wrap" />
                                            <ComboBox Style="{StaticResource DarkCombo}" ItemsSource="{Binding Options}" SelectedItem="{Binding Selected}"
                                                      DisplayMemberPath="Label" Margin="0,4,0,2" />
                                            <TextBlock Text="{Binding Hint}" FontSize="10" Foreground="{StaticResource TextFaint}" TextWrapping="Wrap"
                                                       Visibility="{Binding HasHint, Converter={StaticResource BoolToVis}}" />
                                        </StackPanel>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <TextBlock FontSize="10" Foreground="{StaticResource TextFaint}" TextWrapping="Wrap"
                                       Text="The adapter reconnects for a few seconds after every change." />
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>
            </DockPanel>
        </Border>

        <ScrollViewer Style="{StaticResource ThemedScroll}" HorizontalScrollBarVisibility="Disabled">
            <StackPanel Margin="18,8,18,14">
                <ItemsControl ItemsSource="{Binding Groups}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Margin="0,10,0,4">
                                <TextBlock Text="{Binding Title}" Style="{StaticResource Label10}" Margin="0,0,0,8" />
                                <Border Style="{StaticResource HwCard}">
                                    <ItemsControl ItemsSource="{Binding Rows}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border BorderBrush="{StaticResource RowDivider}" BorderThickness="0,0,0,1" Padding="14,9">
                                                    <DockPanel>
                                                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                                                            <Button Content="Advanced" Style="{StaticResource GhostButtonSm}" Margin="0,0,10,0" VerticalAlignment="Center"
                                                                    Visibility="{Binding HasAdvanced, Converter={StaticResource BoolToVis}}"
                                                                    Command="{Binding DataContext.OpenAdvancedCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                                    CommandParameter="{Binding}" />
                                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center"
                                                                        Visibility="{Binding HasPowerSetting, Converter={StaticResource BoolToVis}}">
                                                                <controls:Badge Text="POWER SAVING" Tone="Medium" Margin="0,0,8,0" VerticalAlignment="Center"
                                                                                Visibility="{Binding PowerSaving, Converter={StaticResource BoolToVis}}" />
                                                                <CheckBox Style="{StaticResource PillToggle}" IsChecked="{Binding PowerSaving, Mode=OneWay}"
                                                                          IsEnabled="{Binding CanToggle}" VerticalAlignment="Center"
                                                                          ToolTip="Allow the computer to turn off this device to save power"
                                                                          Command="{Binding DataContext.TogglePowerCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                                          CommandParameter="{Binding}" />
                                                            </StackPanel>
                                                        </StackPanel>
                                                        <Ellipse x:Name="Dot" Width="7" Height="7" Fill="{StaticResource AccentText}" Margin="0,0,12,0" VerticalAlignment="Center" />
                                                        <StackPanel VerticalAlignment="Center">
                                                            <StackPanel Orientation="Horizontal">
                                                                <TextBlock x:Name="DeviceName" Text="{Binding Name}" FontSize="13" Foreground="{StaticResource TextName}"
                                                                           TextTrimming="CharacterEllipsis" />
                                                                <controls:Badge Text="PROBLEM" Tone="High" Margin="8,0,0,0" VerticalAlignment="Center"
                                                                                Visibility="{Binding IsProblem, Converter={StaticResource BoolToVis}}" />
                                                                <controls:Badge Text="DISABLED" Tone="Neutral" Margin="8,0,0,0" VerticalAlignment="Center"
                                                                                Visibility="{Binding IsDisabled, Converter={StaticResource BoolToVis}}" />
                                                            </StackPanel>
                                                            <TextBlock Text="{Binding Description}" FontSize="11" Foreground="{StaticResource TextBody}" Margin="0,2,0,0"
                                                                       TextTrimming="CharacterEllipsis" />
                                                        </StackPanel>
                                                    </DockPanel>
                                                </Border>
                                                <DataTemplate.Triggers>
                                                    <DataTrigger Binding="{Binding IsProblem}" Value="True">
                                                        <Setter TargetName="Dot" Property="Fill" Value="{StaticResource DangerText}" />
                                                        <Setter TargetName="DeviceName" Property="Foreground" Value="{StaticResource DangerText}" />
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding IsDisabled}" Value="True">
                                                        <Setter TargetName="Dot" Property="Fill" Value="{StaticResource TextFaint}" />
                                                    </DataTrigger>
                                                </DataTemplate.Triggers>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </Border>
                            </StackPanel>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <StackPanel Visibility="{Binding ShowStorage, Converter={StaticResource BoolToVis}}" Margin="0,10,0,0">
                    <DockPanel Margin="0,0,0,8">
                        <Button DockPanel.Dock="Right" Content="Refresh" Command="{Binding RefreshCommand}"
                                Style="{StaticResource GhostButtonSm}" VerticalAlignment="Center" />
                        <TextBlock Text="STORAGE — DRIVES AND VOLUMES" Style="{StaticResource Label10}" VerticalAlignment="Center" />
                    </DockPanel>
                    <Border Style="{StaticResource HwCard}" Padding="14,4" DataContext="{Binding Storage}">
                        <StackPanel>
                            <ItemsControl ItemsSource="{Binding Drives}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Style="{StaticResource KvLine}">
                                            <DockPanel>
                                                <TextBlock DockPanel.Dock="Right" Style="{StaticResource KvValue}" Margin="12,0,0,0">
                                                    <Run Text="{Binding Kind, Mode=OneWay}" /><Run Text=" · " /><Run Text="{Binding Smart, Mode=OneWay}" /><Run Text=" · " /><Run Text="{Binding Capacity, Mode=OneWay}" />
                                                </TextBlock>
                                                <TextBlock Text="{Binding Model}" Style="{StaticResource KvKey}" TextTrimming="CharacterEllipsis" />
                                            </DockPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <ItemsControl ItemsSource="{Binding Volumes}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Style="{StaticResource KvLine}">
                                            <DockPanel>
                                                <TextBlock DockPanel.Dock="Right" Text="{Binding Usage}" Style="{StaticResource KvValue}"
                                                           FontFamily="{StaticResource MonoFont}" Margin="12,0,0,0" />
                                                <TextBlock Text="{Binding Letter}" Style="{StaticResource KvKey}" />
                                            </DockPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>
                    <TextBlock Text="Drive health needs administrator rights and varies by controller. Sizes are in GiB."
                               FontSize="10" Foreground="{StaticResource TextFaint}" Margin="0,6,0,0" TextWrapping="Wrap" />
                </StackPanel>

                <TextBlock Text="No devices match." FontSize="12" Foreground="{StaticResource TextDim}" Margin="0,14,0,0"
                           Visibility="{Binding IsEmpty, Converter={StaticResource BoolToVis}}" />
                <TextBlock FontSize="11" Foreground="{StaticResource TextFaint}" TextWrapping="Wrap" Margin="0,14,0,0"
                           Text="The switch is Windows' &quot;Allow the computer to turn off this device to save power&quot;. Turning it off on USB, input and network devices avoids wake-up lag and dropouts. Tweaker remembers each device's original setting; Revert puts them back." />
            </StackPanel>
        </ScrollViewer>
    </DockPanel>
</UserControl>

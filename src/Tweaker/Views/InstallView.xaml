<UserControl x:Class="Tweaker.Views.InstallView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:conv="clr-namespace:Tweaker.Converters"
             xmlns:controls="clr-namespace:Tweaker.Controls">
    <UserControl.Resources>
        <conv:BoolToVisibilityConverter x:Key="BoolToVis" />
    </UserControl.Resources>
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="140" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0" BorderBrush="{StaticResource BorderSubtle}" BorderThickness="0,0,1,0">
            <DockPanel>
                <TextBlock DockPanel.Dock="Top" Text="CATEGORY" Style="{StaticResource Label10}"
                           Foreground="{StaticResource TextFaint}" Margin="14,16,12,6" />
                <ListBox Style="{StaticResource NavList}" ItemsSource="{Binding Categories}"
                         SelectedItem="{Binding SelectedCategory, Mode=TwoWay}" />
            </DockPanel>
        </Border>

        <DockPanel Grid.Column="1">
            <Border DockPanel.Dock="Top" BorderBrush="{StaticResource BorderSubtle}" BorderThickness="0,0,0,1" Padding="18,12">
                <DockPanel>
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="Checking installed apps…" Foreground="{StaticResource TextDim}" FontSize="11"
                                   VerticalAlignment="Center" Margin="0,0,8,0"
                                   Visibility="{Binding IsCheckingInstalled, Converter={StaticResource BoolToVis}}" />
                        <TextBlock Text="{Binding SelectedCount, StringFormat={}{0} selected}" Foreground="{StaticResource TextDim}"
                                   FontSize="11" VerticalAlignment="Center" Margin="0,0,8,0" />
                        <Button Content="Clear" Style="{StaticResource GhostButton}" Command="{Binding ClearCommand}" Margin="0,0,8,0" />
                        <Button Content="Install Selected" Style="{StaticResource AccentButton}" Command="{Binding InstallSelectedCommand}" />
                    </StackPanel>
                    <Grid Margin="0,0,12,0" VerticalAlignment="Center">
                        <TextBox Style="{StaticResource InputBox}" Padding="26,5,10,5"
                                 Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" />
                        <Canvas Width="12" Height="12" HorizontalAlignment="Left" Margin="8,0,0,0" VerticalAlignment="Center"
                                IsHitTestVisible="False">
                            <Ellipse Canvas.Left="1" Canvas.Top="1" Width="8" Height="8"
                                     Stroke="{StaticResource TextFaint}" StrokeThickness="1.2" />
                            <Line X1="8" Y1="8" X2="11.5" Y2="11.5" Stroke="{StaticResource TextFaint}"
                                  StrokeThickness="1.2" StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
                        </Canvas>
                        <TextBlock Text="Search apps…" Foreground="{StaticResource TextFaint}" FontSize="12" Margin="29,0,0,0"
                                   VerticalAlignment="Center" IsHitTestVisible="False">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding SearchText}" Value="">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </Grid>
                </DockPanel>
            </Border>

            <Border DockPanel.Dock="Top" Background="#1C0E0E" BorderBrush="#3A1A1A" BorderThickness="0,0,0,1" Padding="18,8"
                    Visibility="{Binding WingetAvailable, Converter={StaticResource BoolToVis}, ConverterParameter=invert}">
                <TextBlock Text="winget was not found on this system — installs are disabled. Install 'App Installer' from the Microsoft Store."
                           Foreground="#8A4A4A" FontSize="12" />
            </Border>

            <ScrollViewer Style="{StaticResource ThemedScroll}" HorizontalScrollBarVisibility="Disabled" Padding="14,12">
                <ItemsControl ItemsSource="{Binding Apps}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Button Command="{Binding ToggleCommand}" Width="240" Margin="4" HorizontalContentAlignment="Stretch" Cursor="Hand">
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <Border x:Name="b" Background="{StaticResource BgCard}" BorderBrush="{StaticResource BorderCard}"
                                                BorderThickness="1" CornerRadius="3" Padding="10,9">
                                            <Grid>
                                                <StackPanel Orientation="Horizontal">
                                                    <Grid Width="28" Height="28" Margin="0,1,10,0" VerticalAlignment="Top">
                                                        <Border CornerRadius="6" Background="{Binding TileBrush}" />
                                                        <TextBlock Text="{Binding Initial}" Foreground="{StaticResource TextName}"
                                                                   FontSize="13" FontWeight="SemiBold"
                                                                   HorizontalAlignment="Center" VerticalAlignment="Center"
                                                                   Visibility="{Binding HasMonogram, Converter={StaticResource BoolToVis}}" />
                                                        <Path Data="{Binding BrandGeometry}" Fill="{Binding BrandBrush}" Stretch="Uniform"
                                                              Margin="6" Visibility="{Binding HasBrandIcon, Converter={StaticResource BoolToVis}}" />
                                                        <Image Source="{Binding IconImage}" Margin="3" RenderOptions.BitmapScalingMode="HighQuality"
                                                               Visibility="{Binding HasImageIcon, Converter={StaticResource BoolToVis}}" />
                                                    </Grid>
                                                    <CheckBox IsChecked="{Binding IsTicked, Mode=OneWay}" IsHitTestVisible="False" VerticalAlignment="Top"
                                                              Style="{StaticResource PillToggle}" Margin="0,1,10,0" />
                                                    <StackPanel>
                                                        <TextBlock x:Name="name" Text="{Binding Name}" Foreground="{StaticResource TextName}" FontSize="12" FontWeight="Medium" />
                                                        <TextBlock Text="{Binding Description}" Foreground="{StaticResource TextFaint}" FontSize="11"
                                                                   TextWrapping="Wrap" Margin="0,1,0,0" />
                                                    </StackPanel>
                                                </StackPanel>
                                                <controls:Badge Text="INSTALLED" Tone="Low" HorizontalAlignment="Right" VerticalAlignment="Top"
                                                                ToolTip="{Binding InstalledTip}"
                                                                Visibility="{Binding IsInstalled, Converter={StaticResource BoolToVis}}" />
                                            </Grid>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <DataTrigger Binding="{Binding IsInstalled}" Value="True">
                                                <Setter TargetName="b" Property="Background" Value="{StaticResource RowApplied}" />
                                                <Setter TargetName="b" Property="BorderBrush" Value="{StaticResource AccentBorder}" />
                                                <Setter TargetName="name" Property="Foreground" Value="{StaticResource TextActive}" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding Selected}" Value="True">
                                                <Setter TargetName="b" Property="Background" Value="{StaticResource RowApplied}" />
                                                <Setter TargetName="b" Property="BorderBrush" Value="{StaticResource AccentBorder}" />
                                            </DataTrigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Button.Template>
                            </Button>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </DockPanel>
    </Grid>
</UserControl>

<UserControl x:Class="Tweaker.Views.ProcessesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:conv="clr-namespace:Tweaker.Converters"
             xmlns:controls="clr-namespace:Tweaker.Controls">
    <UserControl.Resources>
        <conv:BoolToVisibilityConverter x:Key="BoolToVis" />
        <conv:UsageLevelBrushConverter x:Key="UsageBrush" />
        <Style x:Key="NumberCell" TargetType="TextBlock" BasedOn="{StaticResource TableCellMono}">
            <Setter Property="FontSize" Value="11" />
            <Setter Property="HorizontalAlignment" Value="Right" />
        </Style>
        <Style x:Key="SegGroup" TargetType="Border">
            <Setter Property="BorderBrush" Value="{StaticResource BorderInput}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="3" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
    </UserControl.Resources>

    <DockPanel>
        <Border DockPanel.Dock="Top" Style="{StaticResource ToolbarBorder}">
            <DockPanel>
                <TextBlock DockPanel.Dock="Right" Text="{Binding Message}" FontSize="11" Foreground="{StaticResource TextDim}"
                           VerticalAlignment="Center" TextTrimming="CharacterEllipsis" MaxWidth="340" Margin="12,0,0,0" />
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Grid Width="200" Margin="0,0,8,0" VerticalAlignment="Center">
                        <TextBox Style="{StaticResource InputBox}" Padding="26,4,8,4"
                                 Text="{Binding Filter, UpdateSourceTrigger=PropertyChanged}" />
                        <Canvas Width="12" Height="12" HorizontalAlignment="Left" Margin="8,0,0,0" VerticalAlignment="Center"
                                IsHitTestVisible="False">
                            <Ellipse Canvas.Left="1" Canvas.Top="1" Width="8" Height="8"
                                     Stroke="{StaticResource TextFaint}" StrokeThickness="1.2" />
                            <Line X1="8" Y1="8" X2="11.5" Y2="11.5" Stroke="{StaticResource TextFaint}"
                                  StrokeThickness="1.2" StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
                        </Canvas>
                        <TextBlock Text="Filter processes…" Foreground="{StaticResource TextFaint}" FontSize="12"
                                   Margin="29,0,0,0" VerticalAlignment="Center" IsHitTestVisible="False">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Filter}" Value="">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </Grid>
                    <Border Style="{StaticResource SegGroup}">
                        <StackPanel Orientation="Horizontal">
                            <Button Content="All" Command="{Binding SetViewCommand}" CommandParameter="All"
                                    Tag="{Binding IsAll}" Style="{StaticResource SegmentedButton}" />
                            <Button Content="Apps" Command="{Binding SetViewCommand}" CommandParameter="Apps"
                                    Tag="{Binding IsApps}" Style="{StaticResource SegmentedButton}" BorderThickness="1,0,0,0" />
                            <Button Content="Background" Command="{Binding SetViewCommand}" CommandParameter="Background"
                                    Tag="{Binding IsBackground}" Style="{StaticResource SegmentedButton}" BorderThickness="1,0,0,0" />
                            <Button Content="Windows" Command="{Binding SetViewCommand}" CommandParameter="Windows"
                                    Tag="{Binding IsWindows}" Style="{StaticResource SegmentedButton}" BorderThickness="1,0,0,0" />
                        </StackPanel>
                    </Border>
                    <TextBlock Text="RAM" FontSize="11" Foreground="{StaticResource TextDim}" Margin="12,0,6,0" VerticalAlignment="Center" />
                    <Border Style="{StaticResource SegGroup}">
                        <StackPanel Orientation="Horizontal">
                            <Button Content="MB" Command="{Binding SetRamUnitCommand}" CommandParameter="MB"
                                    Tag="{Binding IsRamMb}" Style="{StaticResource SegmentedButton}" />
                            <Button Content="%" Command="{Binding SetRamUnitCommand}" CommandParameter="%"
                                    Tag="{Binding IsRamPercent}" Style="{StaticResource SegmentedButton}" BorderThickness="1,0,0,0" />
                        </StackPanel>
                    </Border>
                    <TextBlock Text="{Binding CountText}" FontSize="11" Foreground="{StaticResource TextDim}" Margin="12,0,0,0"
                               VerticalAlignment="Center" />
                    <controls:Badge Text="{Binding ProfileBadgeText}" Tone="Medium" Margin="12,0,0,0" VerticalAlignment="Center"
                                    Visibility="{Binding ShowProfileBadge, Converter={StaticResource BoolToVis}}" />
                </StackPanel>
            </DockPanel>
        </Border>

        <DataGrid x:Name="Table" Style="{StaticResource DataTable}" ItemsSource="{Binding Rows}" Sorting="Table_Sorting">
            <DataGrid.Columns>
                <DataGridTextColumn Header="NAME" Binding="{Binding Name, Mode=OneWay}" SortMemberPath="Name" Width="2*">
                    <DataGridTextColumn.ElementStyle>
                        <Style TargetType="TextBlock">
                            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
                            <Setter Property="VerticalAlignment" Value="Center" />
                        </Style>
                    </DataGridTextColumn.ElementStyle>
                </DataGridTextColumn>
                <DataGridTextColumn Header="PID" Binding="{Binding Pid, Mode=OneWay}" SortMemberPath="Pid" Width="64"
                                    ElementStyle="{StaticResource NumberCell}" HeaderStyle="{StaticResource DataTableHeaderRight}" />
                <DataGridTextColumn Header="CPU %" Binding="{Binding CpuText, Mode=OneWay}" SortMemberPath="Cpu" Width="70"
                                    HeaderStyle="{StaticResource DataTableHeaderRight}">
                    <DataGridTextColumn.ElementStyle>
                        <Style TargetType="TextBlock" BasedOn="{StaticResource NumberCell}">
                            <Setter Property="Foreground" Value="{Binding CpuLevel, Converter={StaticResource UsageBrush}}" />
                        </Style>
                    </DataGridTextColumn.ElementStyle>
                </DataGridTextColumn>
                <DataGridTextColumn Header="RAM" Binding="{Binding RamText, Mode=OneWay}" SortMemberPath="RamBytes" Width="76"
                                    HeaderStyle="{StaticResource DataTableHeaderRight}">
                    <DataGridTextColumn.ElementStyle>
                        <Style TargetType="TextBlock" BasedOn="{StaticResource NumberCell}">
                            <Setter Property="Foreground" Value="{Binding RamLevel, Converter={StaticResource UsageBrush}}" />
                        </Style>
                    </DataGridTextColumn.ElementStyle>
                </DataGridTextColumn>
                <DataGridTextColumn Header="DISK MB/S" Binding="{Binding DiskText, Mode=OneWay}" SortMemberPath="Disk" Width="86"
                                    HeaderStyle="{StaticResource DataTableHeaderRight}">
                    <DataGridTextColumn.ElementStyle>
                        <Style TargetType="TextBlock" BasedOn="{StaticResource NumberCell}">
                            <Setter Property="Foreground" Value="{Binding DiskLevel, Converter={StaticResource UsageBrush}}" />
                        </Style>
                    </DataGridTextColumn.ElementStyle>
                </DataGridTextColumn>
                <DataGridTextColumn Header="GPU %" Binding="{Binding GpuText, Mode=OneWay}" SortMemberPath="Gpu" Width="70"
                                    HeaderStyle="{StaticResource DataTableHeaderRight}">
                    <DataGridTextColumn.ElementStyle>
                        <Style TargetType="TextBlock" BasedOn="{StaticResource NumberCell}">
                            <Setter Property="Foreground" Value="{Binding GpuLevel, Converter={StaticResource UsageBrush}}" />
                        </Style>
                    </DataGridTextColumn.ElementStyle>
                </DataGridTextColumn>
                <DataGridTemplateColumn Header="OWNER" SortMemberPath="Owner" Width="1*">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <TextBlock x:Name="OwnerText" Text="{Binding Owner}" FontSize="11" Foreground="{StaticResource TextDim}"
                                       VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                            <DataTemplate.Triggers>
                                <DataTrigger Binding="{Binding IsUserOwner}" Value="True">
                                    <Setter TargetName="OwnerText" Property="Foreground" Value="{StaticResource TextMuted}" />
                                </DataTrigger>
                            </DataTemplate.Triggers>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTemplateColumn Header="" Width="96" CanUserSort="False">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <Grid HorizontalAlignment="Right">
                                <controls:Badge Text="PROTECTED" Tone="Low" VerticalAlignment="Center"
                                                Visibility="{Binding IsProtected, Converter={StaticResource BoolToVis}}" />
                                <Button Content="End task" Style="{StaticResource DangerButtonSm}"
                                        Command="{Binding DataContext.EndTaskCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                        CommandParameter="{Binding}"
                                        Visibility="{Binding ShowEndTask, Converter={StaticResource BoolToVis}}" />
                                <Button Content="Confirm" Style="{StaticResource DangerButtonSm}"
                                        Command="{Binding DataContext.ConfirmEndTaskCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                        CommandParameter="{Binding}"
                                        Visibility="{Binding IsConfirming, Converter={StaticResource BoolToVis}}" />
                            </Grid>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
            </DataGrid.Columns>
        </DataGrid>
    </DockPanel>
</UserControl>

<Window x:Class="Tweaker.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:sys="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        xmlns:vm="clr-namespace:Tweaker.ViewModels"
        xmlns:views="clr-namespace:Tweaker.Views"
        xmlns:conv="clr-namespace:Tweaker.Converters"
        xmlns:controls="clr-namespace:Tweaker.Controls"
        Title="Tweaker" Icon="/icon.ico" Height="700" Width="1080" MinHeight="500" MinWidth="920"
        FontFamily="{StaticResource AppFont}" Foreground="{StaticResource TextPrimary}"
        Background="{StaticResource BgRoot}" UseLayoutRounding="True" TextOptions.TextFormattingMode="Ideal">
    <sys:WindowChrome.WindowChrome>
        <sys:WindowChrome CaptionHeight="42" ResizeBorderThickness="6" GlassFrameThickness="0"
                          CornerRadius="0" UseAeroCaptionButtons="False" />
    </sys:WindowChrome.WindowChrome>

    <Window.Resources>
        <DataTemplate DataType="{x:Type vm:MainViewModel}">
            <views:TweaksView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:InstallViewModel}">
            <views:InstallView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:ConfigViewModel}">
            <views:ConfigView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:UpdatesViewModel}">
            <views:UpdatesView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:NvidiaViewModel}">
            <views:NvidiaView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:PerformanceViewModel}">
            <views:PerformanceView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:NetworkViewModel}">
            <views:NetworkView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:ProcessesViewModel}">
            <views:ProcessesView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:ServicesViewModel}">
            <views:ServicesView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:ProfilesViewModel}">
            <views:ProfilesView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:ResourcesViewModel}">
            <views:ResourcesView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:HardwareViewModel}">
            <views:HardwareView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:InspectorViewModel}">
            <views:InspectorView />
        </DataTemplate>
        <conv:BoolToVisibilityConverter x:Key="BoolToVis" />
    </Window.Resources>

    <Border x:Name="RootBorder" BorderBrush="{StaticResource BorderCard}" BorderThickness="1">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Border Grid.Row="0" Height="42" Background="{StaticResource BgTitle}"
                    BorderBrush="{StaticResource BorderSubtle}" BorderThickness="0,0,0,1">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" Margin="16,0,0,0">
                        <Image Source="/icon.ico" Width="20" Height="20" VerticalAlignment="Center" Margin="0,3,8,0"
                               RenderOptions.BitmapScalingMode="HighQuality" />
                        <TextBlock Text="Tweaker" Foreground="{StaticResource LogoText}" FontWeight="SemiBold" FontSize="12" VerticalAlignment="Center" />
                        <TextBlock Text="v1.0" FontFamily="{StaticResource MonoFont}" Foreground="{StaticResource TextGhost}" FontSize="10" Margin="8,2,0,0" VerticalAlignment="Center" />
                    </StackPanel>

                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="28,0,0,0"
                                DataContext="{Binding Resources.Performance}">
                        <controls:MetricChip Label="CPU" Unit="%" SeriesBrush="{StaticResource SeriesCpu}" Margin="0,0,18,0"
                                             Value="{Binding Cpu.ValueText}" History="{Binding Cpu.History}" Maximum="{Binding Cpu.Maximum}" />
                        <controls:MetricChip Label="MEM" Unit="GB" SeriesBrush="{StaticResource SeriesRam}" Margin="0,0,18,0"
                                             Value="{Binding Memory.ValueText}" History="{Binding Memory.History}" Maximum="{Binding Memory.Maximum}" />
                        <controls:MetricChip Label="DISK" Unit="MB/s" SeriesBrush="{StaticResource SeriesDisk}" Margin="0,0,18,0"
                                             Value="{Binding Disk.ValueText}" History="{Binding Disk.History}" Maximum="{Binding Disk.Maximum}" />
                        <controls:MetricChip Label="NET" Unit="MB/s" SeriesBrush="{StaticResource SeriesNet}" Margin="0,0,18,0"
                                             Value="{Binding Network.ValueText}" History="{Binding Network.History}" Maximum="{Binding Network.Maximum}" />
                        <controls:MetricChip Label="GPU" Unit="%" SeriesBrush="{StaticResource SeriesGpu}"
                                             Value="{Binding Gpu.ValueText}" History="{Binding Gpu.History}" Maximum="{Binding Gpu.Maximum}" />
                    </StackPanel>

                    <StackPanel Grid.Column="4" Orientation="Horizontal" VerticalAlignment="Stretch"
                                sys:WindowChrome.IsHitTestVisibleInChrome="True">
                        <Button Content="&#xE921;" Style="{StaticResource WinButton}" Click="Minimize_Click" />
                        <Button Content="&#xE922;" Style="{StaticResource WinButton}" Click="MaxRestore_Click" />
                        <Button Content="&#xE8BB;" Style="{StaticResource WinCloseButton}" Click="Close_Click" />
                    </StackPanel>
                </Grid>
            </Border>

            <Border Grid.Row="1" Height="36" Background="{StaticResource BgTitle}"
                    BorderBrush="{StaticResource BorderSubtle}" BorderThickness="0,0,0,1">
                <DockPanel>
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,10,0">
                        <TextBlock x:Name="OsInfoText" VerticalAlignment="Center" Margin="0,0,10,0"
                                   Foreground="{StaticResource TextGhost}" FontSize="11" Text="Windows" />
                        <ToggleButton x:Name="HelpToggle" Style="{StaticResource HelpButton}"
                                      ToolTip="What do the toggles mean?" />
                        <Popup IsOpen="{Binding IsChecked, ElementName=HelpToggle}" PlacementTarget="{Binding ElementName=HelpToggle}"
                               Placement="Bottom" HorizontalOffset="-278" VerticalOffset="6" StaysOpen="False" AllowsTransparency="True">
                            <Border Background="{StaticResource BgCard}" BorderBrush="{StaticResource BorderCard}" BorderThickness="1"
                                    CornerRadius="6" Padding="14,12" Width="300">
                                <StackPanel>
                                    <TextBlock Text="READING THE STATE" Style="{StaticResource Label10}"
                                               Foreground="{StaticResource TextDim}" Margin="0,0,0,10" />
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                        <CheckBox Style="{StaticResource PillToggle}" IsChecked="True" IsHitTestVisible="False" VerticalAlignment="Center" />
                                        <TextBlock Text="ON — the tweak is applied" Foreground="{StaticResource TextName}"
                                                   FontSize="11" VerticalAlignment="Center" Margin="10,0,0,0" />
                                    </StackPanel>
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                                        <CheckBox Style="{StaticResource PillToggle}" IsChecked="False" IsHitTestVisible="False" VerticalAlignment="Center" />
                                        <TextBlock Text="OFF — not applied" Foreground="{StaticResource TextName}"
                                                   FontSize="11" VerticalAlignment="Center" Margin="10,0,0,0" />
                                    </StackPanel>
                                    <TextBlock Foreground="{StaticResource TextBody}" FontSize="11" TextWrapping="Wrap">
                                        <Run Text="An applied row is tinted green and its name brightens." /><LineBreak />
                                        <Run Text="Every tweak — registry, script or NVIDIA — is a switch; flipping it queues the change in the bar at the bottom, and Apply runs the queue." /><LineBreak />
                                        <Run Text="Run-once actions (Maintenance) have a single Run button — they can't be undone." />
                                    </TextBlock>
                                </StackPanel>
                            </Border>
                        </Popup>
                    </StackPanel>

                    <StackPanel Orientation="Horizontal" VerticalAlignment="Stretch" Margin="6,0,0,0">
                        <Button Content="Tweaks"  Command="{Binding SelectTabCommand}" CommandParameter="Tweaks"  Tag="{Binding IsTweaks}"  Style="{StaticResource TabButton}" />
                        <Button Content="NVIDIA"  Command="{Binding SelectTabCommand}" CommandParameter="Nvidia"  Tag="{Binding IsNvidia}"  Style="{StaticResource TabButton}" Visibility="{Binding IsNvidiaVisible, Converter={StaticResource BoolToVis}}" />
                        <Button Content="Config"  Command="{Binding SelectTabCommand}" CommandParameter="Config"  Tag="{Binding IsConfig}"  Style="{StaticResource TabButton}" />
                        <Button Content="Install" Command="{Binding SelectTabCommand}" CommandParameter="Install" Tag="{Binding IsInstall}" Style="{StaticResource TabButton}" />
                        <Button Command="{Binding SelectTabCommand}" CommandParameter="Resources" Tag="{Binding IsResources}" Style="{StaticResource TabButton}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="Resources" />
                                <Ellipse Width="5" Height="5" Fill="{StaticResource AccentText}" Margin="6,0,0,0" VerticalAlignment="Center"
                                         Visibility="{Binding IsProfileActive, Converter={StaticResource BoolToVis}}" ToolTip="An App Profile is active" />
                            </StackPanel>
                        </Button>
                        <Button Content="Hardware" Command="{Binding SelectTabCommand}" CommandParameter="Hardware" Tag="{Binding IsHardware}" Style="{StaticResource TabButton}" />
                        <Button Content="Inspector" Command="{Binding SelectTabCommand}" CommandParameter="Inspector" Tag="{Binding IsInspector}" Style="{StaticResource TabButton}" />
                        <Button Content="Updates" Command="{Binding SelectTabCommand}" CommandParameter="Updates" Tag="{Binding IsUpdates}" Style="{StaticResource TabButton}" />
                    </StackPanel>
                </DockPanel>
            </Border>

            <ContentControl Grid.Row="2" Content="{Binding Current}" />

            <views:PendingBar Grid.Row="3" DataContext="{Binding Pending}"
                              Visibility="{Binding IsVisible, Converter={StaticResource BoolToVis}}" />

            <controls:StatusBar Grid.Row="4" Lines="{Binding ActivityLines}" />

            <Border Grid.Row="5" Background="{StaticResource BgTitle}" BorderBrush="{StaticResource BorderSubtle}"
                    BorderThickness="0,1,0,0" Padding="16,4">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Right" Text="{Binding Freed.TotalText}" FontSize="10"
                               Foreground="{StaticResource TextMuted}" ToolTip="{Binding Freed.TooltipText}"
                               Margin="12,0,0,0" VerticalAlignment="Center"
                               Visibility="{Binding Freed.HasTotal, Converter={StaticResource BoolToVis}}" />
                    <TextBlock Text="{Binding Tip}" FontSize="10" Foreground="{StaticResource TextFaint}" TextWrapping="Wrap" />
                </DockPanel>
            </Border>
        </Grid>
    </Border>
</Window>

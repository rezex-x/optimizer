<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib"
                    xmlns:conv="clr-namespace:Tweaker.Converters">

    <conv:EqualityMultiConverter x:Key="AreEqual" />
    <conv:VerticalThicknessConverter x:Key="VerticalOnly" />

    <FontFamily x:Key="AppFont">pack://application:,,,/Resources/Fonts/#Inter</FontFamily>
    <FontFamily x:Key="MonoFont">pack://application:,,,/Resources/Fonts/#JetBrains Mono</FontFamily>

    <SolidColorBrush x:Key="BgRoot"     Color="#0A0A0A" />
    <SolidColorBrush x:Key="BgTitle"    Color="#0C0C0C" />
    <SolidColorBrush x:Key="BgCard"     Color="#111111" />
    <SolidColorBrush x:Key="BgPanel"    Color="#0E0E0E" />
    <SolidColorBrush x:Key="BgInput"    Color="#141414" />
    <SolidColorBrush x:Key="BgNavActive" Color="#181818" />
    <SolidColorBrush x:Key="TabHoverBg" Color="#141414" />
    <SolidColorBrush x:Key="RowDivider" Color="#181818" />
    <SolidColorBrush x:Key="RowApplied" Color="#121812" />

    <SolidColorBrush x:Key="BorderSubtle" Color="#1A1A1A" />
    <SolidColorBrush x:Key="BorderCard"   Color="#1C1C1C" />
    <SolidColorBrush x:Key="BorderInput"  Color="#222222" />

    <SolidColorBrush x:Key="TextPrimary" Color="#E6E6E6" />
    <SolidColorBrush x:Key="TextActive"  Color="#F0F0F0" />
    <SolidColorBrush x:Key="TextName"    Color="#B8B8B8" />
    <SolidColorBrush x:Key="TextBody"    Color="#A0A0A0" />
    <SolidColorBrush x:Key="TextMuted"   Color="#707070" />
    <SolidColorBrush x:Key="TextDim"     Color="#4A4A4A" />
    <SolidColorBrush x:Key="TextFaint"   Color="#3A3A3A" />
    <SolidColorBrush x:Key="TextGhost"   Color="#2A2A2A" />
    <SolidColorBrush x:Key="LogoText"    Color="#505050" />
    <SolidColorBrush x:Key="LabelText"   Color="#606060" />
    <SolidColorBrush x:Key="LogText"     Color="#5A8A5A" />

    <SolidColorBrush x:Key="AccentText"     Color="#6AAA6A" />
    <SolidColorBrush x:Key="AccentTextSoft" Color="#7AB87A" />
    <SolidColorBrush x:Key="AccentBg"       Color="#1A2E1A" />
    <SolidColorBrush x:Key="AccentBorder"   Color="#2A462A" />
    <SolidColorBrush x:Key="NavAccent"      Color="#3A5A3A" />

    <SolidColorBrush x:Key="DefaultBtnBg"     Color="#1C1C1C" />
    <SolidColorBrush x:Key="DefaultBtnBorder" Color="#282828" />
    <SolidColorBrush x:Key="DefaultBtnText"   Color="#8A8A8A" />
    <SolidColorBrush x:Key="GhostBtnText"     Color="#606060" />
    <SolidColorBrush x:Key="GhostBtnBorder"   Color="#222222" />

    <SolidColorBrush x:Key="ScrollThumb"      Color="#2C2C2C" />
    <SolidColorBrush x:Key="ScrollThumbHover" Color="#3A5A3A" />

    <SolidColorBrush x:Key="ToggleOffBg"     Color="#181818" />
    <SolidColorBrush x:Key="ToggleOffBorder" Color="#242424" />
    <SolidColorBrush x:Key="ToggleOffThumb"  Color="#363636" />
    <SolidColorBrush x:Key="ToggleOnBg"      Color="#1E331E" />
    <SolidColorBrush x:Key="ToggleOnBorder"  Color="#3A5A3A" />
    <SolidColorBrush x:Key="ToggleOnThumb"   Color="#6AAA6A" />

    <Style x:Key="Label10" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource AppFont}" />
        <Setter Property="FontSize" Value="10" />
        <Setter Property="Foreground" Value="{StaticResource LabelText}" />
    </Style>

    <Style x:Key="SectionHeader" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource AppFont}" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="FontWeight" Value="Bold" />
        <Setter Property="Foreground" Value="{StaticResource TextName}" />
    </Style>

    <Style x:Key="RowStatusText" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource MonoFont}" />
        <Setter Property="FontSize" Value="10" />
        <Setter Property="Foreground" Value="{StaticResource LogText}" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <Style x:Key="ToolbarBorder" TargetType="Border">
        <Setter Property="BorderBrush" Value="{StaticResource BorderSubtle}" />
        <Setter Property="BorderThickness" Value="0,0,0,1" />
        <Setter Property="Padding" Value="18,12" />
    </Style>

    <Style x:Key="PillToggle" TargetType="CheckBox">
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="CheckBox">
                    <Border x:Name="track" Width="36" Height="20" CornerRadius="10"
                            Background="{StaticResource ToggleOffBg}"
                            BorderBrush="{StaticResource ToggleOffBorder}" BorderThickness="1">
                        <Ellipse x:Name="thumb" Width="12" Height="12" HorizontalAlignment="Left"
                                 VerticalAlignment="Center" Margin="3,0,0,0"
                                 Fill="{StaticResource ToggleOffThumb}" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="track" Property="Background" Value="{StaticResource ToggleOnBg}" />
                            <Setter TargetName="track" Property="BorderBrush" Value="{StaticResource ToggleOnBorder}" />
                            <Setter TargetName="thumb" Property="Fill" Value="{StaticResource ToggleOnThumb}" />
                            <Setter TargetName="thumb" Property="HorizontalAlignment" Value="Right" />
                            <Setter TargetName="thumb" Property="Margin" Value="0,0,3,0" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="PillButtonBase" TargetType="Button">
        <Setter Property="FontFamily" Value="{StaticResource AppFont}" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="Padding" Value="14,6" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="1" CornerRadius="3" Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Opacity" Value="0.82" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.4" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="AccentButton" TargetType="Button" BasedOn="{StaticResource PillButtonBase}">
        <Setter Property="Background" Value="{StaticResource AccentBg}" />
        <Setter Property="BorderBrush" Value="{StaticResource AccentBorder}" />
        <Setter Property="Foreground" Value="{StaticResource AccentTextSoft}" />
    </Style>

    <Style x:Key="DefaultButton" TargetType="Button" BasedOn="{StaticResource PillButtonBase}">
        <Setter Property="Background" Value="{StaticResource DefaultBtnBg}" />
        <Setter Property="BorderBrush" Value="{StaticResource DefaultBtnBorder}" />
        <Setter Property="Foreground" Value="{StaticResource DefaultBtnText}" />
    </Style>

    <Style x:Key="RestorePointButton" TargetType="Button" BasedOn="{StaticResource PillButtonBase}">
        <Setter Property="Background" Value="#241618" />
        <Setter Property="BorderBrush" Value="#5A2E2E" />
        <Setter Property="Foreground" Value="#F0A0A0" />
    </Style>

    <Style x:Key="GhostButton" TargetType="Button" BasedOn="{StaticResource PillButtonBase}">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderBrush" Value="{StaticResource GhostBtnBorder}" />
        <Setter Property="Foreground" Value="{StaticResource GhostBtnText}" />
    </Style>

    <Style x:Key="AccentButtonSm" TargetType="Button" BasedOn="{StaticResource AccentButton}">
        <Setter Property="FontSize" Value="11" />
        <Setter Property="Padding" Value="10,3" />
    </Style>
    <Style x:Key="GhostButtonSm" TargetType="Button" BasedOn="{StaticResource GhostButton}">
        <Setter Property="FontSize" Value="11" />
        <Setter Property="Padding" Value="10,3" />
    </Style>

    <Style x:Key="InputBox" TargetType="TextBox">
        <Setter Property="FontFamily" Value="{StaticResource AppFont}" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="Foreground" Value="{StaticResource TextPrimary}" />
        <Setter Property="CaretBrush" Value="{StaticResource TextPrimary}" />
        <Setter Property="Background" Value="{StaticResource BgInput}" />
        <Setter Property="BorderBrush" Value="{StaticResource BorderInput}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Padding" Value="8,5" />
        <Setter Property="AllowDrop" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TextBox">
                    <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="3">
                        <ScrollViewer x:Name="PART_ContentHost"
                                      Margin="{Binding Padding, RelativeSource={RelativeSource TemplatedParent}, Converter={StaticResource VerticalOnly}}"
                                      VerticalScrollBarVisibility="Hidden" HorizontalScrollBarVisibility="Hidden" />
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="MonoInputBox" TargetType="TextBox" BasedOn="{StaticResource InputBox}">
        <Setter Property="FontFamily" Value="{StaticResource MonoFont}" />
        <Setter Property="FontSize" Value="11" />
        <Setter Property="AcceptsReturn" Value="True" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>

    <Style x:Key="DarkComboItem" TargetType="ComboBoxItem">
        <Setter Property="FontFamily" Value="{StaticResource AppFont}" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="Foreground" Value="{StaticResource TextPrimary}" />
        <Setter Property="Padding" Value="8,5" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ComboBoxItem">
                    <Border x:Name="b" Background="Transparent" Padding="{TemplateBinding Padding}">
                        <ContentPresenter />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsHighlighted" Value="True">
                            <Setter TargetName="b" Property="Background" Value="{StaticResource BgNavActive}" />
                            <Setter Property="Foreground" Value="{StaticResource TextActive}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="DarkCombo" TargetType="ComboBox">
        <Setter Property="FontFamily" Value="{StaticResource AppFont}" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="Foreground" Value="{StaticResource TextPrimary}" />
        <Setter Property="Height" Value="28" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="ItemContainerStyle" Value="{StaticResource DarkComboItem}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ComboBox">
                    <Grid>
                        <ToggleButton Focusable="False" ClickMode="Press"
                                      IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}">
                            <ToggleButton.Template>
                                <ControlTemplate TargetType="ToggleButton">
                                    <Border Background="{StaticResource BgInput}" BorderBrush="{StaticResource BorderInput}"
                                            BorderThickness="1" CornerRadius="3">
                                        <Path HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,9,0"
                                              Data="M0,0 L4,4 L8,0" Stroke="{StaticResource TextDim}" StrokeThickness="1.2" />
                                    </Border>
                                </ControlTemplate>
                            </ToggleButton.Template>
                        </ToggleButton>
                        <ContentPresenter Content="{TemplateBinding SelectionBoxItem}"
                                          ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                          Margin="9,0,24,0" VerticalAlignment="Center" IsHitTestVisible="False" />
                        <Popup IsOpen="{TemplateBinding IsDropDownOpen}" Placement="Bottom" AllowsTransparency="True" Focusable="False">
                            <Border Background="{StaticResource BgCard}" BorderBrush="{StaticResource BorderInput}"
                                    BorderThickness="1" CornerRadius="3" Margin="0,2,0,0"
                                    MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}">
                                <ItemsPresenter />
                            </Border>
                        </Popup>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="SliderTrackFill" TargetType="RepeatButton">
        <Setter Property="Focusable" Value="False" />
        <Setter Property="IsTabStop" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RepeatButton">
                    <Border Height="4" CornerRadius="2" Background="{TemplateBinding Background}" />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style x:Key="DarkSlider" TargetType="Slider">
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="IsMoveToPointEnabled" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Slider">
                    <Grid Height="16">
                        <Border Height="4" CornerRadius="2" Background="{StaticResource BorderInput}" VerticalAlignment="Center" />
                        <Track x:Name="PART_Track">
                            <Track.DecreaseRepeatButton>
                                <RepeatButton Command="Slider.DecreaseLarge" Style="{StaticResource SliderTrackFill}" Background="{StaticResource NavAccent}" />
                            </Track.DecreaseRepeatButton>
                            <Track.IncreaseRepeatButton>
                                <RepeatButton Command="Slider.IncreaseLarge" Style="{StaticResource SliderTrackFill}" Background="Transparent" />
                            </Track.IncreaseRepeatButton>
                            <Track.Thumb>
                                <Thumb>
                                    <Thumb.Template>
                                        <ControlTemplate TargetType="Thumb">
                                            <Ellipse Width="12" Height="12" Fill="{StaticResource AccentText}" />
                                        </ControlTemplate>
                                    </Thumb.Template>
                                </Thumb>
                            </Track.Thumb>
                        </Track>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="NavItem" TargetType="ListBoxItem">
        <Setter Property="FontFamily" Value="{StaticResource AppFont}" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="Foreground" Value="{StaticResource TextDim}" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ListBoxItem">
                    <Border x:Name="b" Background="Transparent" BorderThickness="2,0,0,0"
                            BorderBrush="Transparent" Padding="10,6">
                        <ContentPresenter />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Foreground" Value="{StaticResource TextMuted}" />
                        </Trigger>
                        <DataTrigger Value="True">
                            <DataTrigger.Binding>
                                <MultiBinding Converter="{StaticResource AreEqual}">
                                    <Binding Path="Content" RelativeSource="{RelativeSource Self}" />
                                    <Binding Path="DataContext.ActiveCategory" RelativeSource="{RelativeSource AncestorType=ListBox}" />
                                </MultiBinding>
                            </DataTrigger.Binding>
                            <Setter TargetName="b" Property="BorderBrush" Value="{StaticResource NavAccent}" />
                            <Setter Property="Foreground" Value="{StaticResource TextMuted}" />
                        </DataTrigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="b" Property="Background" Value="{StaticResource BgNavActive}" />
                            <Setter TargetName="b" Property="BorderBrush" Value="{StaticResource NavAccent}" />
                            <Setter Property="Foreground" Value="{StaticResource TextActive}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="NavList" TargetType="ListBox">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Hidden" />
        <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled" />
        <Setter Property="ItemContainerStyle" Value="{StaticResource NavItem}" />
    </Style>

    <Style TargetType="ScrollBar">
        <Setter Property="Width" Value="8" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ScrollBar">
                    <Grid Background="Transparent">
                        <Track x:Name="PART_Track" IsDirectionReversed="True">
                            <Track.Thumb>
                                <Thumb>
                                    <Thumb.Template>
                                        <ControlTemplate TargetType="Thumb">
                                            <Border x:Name="t" CornerRadius="4" Margin="2,2"
                                                    Background="{StaticResource ScrollThumb}" />
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="t" Property="Background" Value="{StaticResource ScrollThumbHover}" />
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Thumb.Template>
                                </Thumb>
                            </Track.Thumb>
                            <Track.IncreaseRepeatButton>
                                <RepeatButton Command="ScrollBar.PageDownCommand" Opacity="0" Focusable="False" IsTabStop="False" />
                            </Track.IncreaseRepeatButton>
                            <Track.DecreaseRepeatButton>
                                <RepeatButton Command="ScrollBar.PageUpCommand" Opacity="0" Focusable="False" IsTabStop="False" />
                            </Track.DecreaseRepeatButton>
                        </Track>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="ThemedScroll" TargetType="ScrollViewer">
        <Setter Property="VerticalScrollBarVisibility" Value="Auto" />
        <Setter Property="HorizontalScrollBarVisibility" Value="Disabled" />
    </Style>

    <Style x:Key="TabButton" TargetType="Button">
        <Setter Property="FontFamily" Value="{StaticResource AppFont}" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="Foreground" Value="{StaticResource TextDim}" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Padding" Value="10,0" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="b" Background="Transparent" BorderBrush="Transparent" BorderThickness="2,0,0,0" Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="b" Property="Background" Value="{StaticResource TabHoverBg}" />
                            <Setter Property="Foreground" Value="{StaticResource TextMuted}" />
                        </Trigger>
                        <Trigger Property="Tag">
                            <Trigger.Value><sys:Boolean>True</sys:Boolean></Trigger.Value>
                            <Setter TargetName="b" Property="BorderBrush" Value="{StaticResource NavAccent}" />
                            <Setter TargetName="b" Property="Background" Value="{StaticResource BgNavActive}" />
                            <Setter Property="Foreground" Value="{StaticResource TextActive}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="SubTabButton" TargetType="Button">
        <Setter Property="FontFamily" Value="{StaticResource AppFont}" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="Foreground" Value="{StaticResource TextDim}" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="HorizontalContentAlignment" Value="Left" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="b" Background="Transparent" BorderBrush="Transparent" BorderThickness="2,0,0,0" Padding="10,6">
                        <ContentPresenter HorizontalAlignment="Left" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Foreground" Value="{StaticResource TextMuted}" />
                        </Trigger>
                        <Trigger Property="Tag">
                            <Trigger.Value><sys:Boolean>True</sys:Boolean></Trigger.Value>
                            <Setter TargetName="b" Property="BorderBrush" Value="{StaticResource NavAccent}" />
                            <Setter TargetName="b" Property="Background" Value="{StaticResource BgNavActive}" />
                            <Setter Property="Foreground" Value="{StaticResource TextActive}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="WinButton" TargetType="Button">
        <Setter Property="Width" Value="44" />
        <Setter Property="FontFamily" Value="Segoe MDL2 Assets" />
        <Setter Property="FontSize" Value="10" />
        <Setter Property="Foreground" Value="{StaticResource TextMuted}" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="b" Background="Transparent">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="b" Property="Background" Value="{StaticResource BgNavActive}" />
                            <Setter Property="Foreground" Value="{StaticResource TextActive}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="WinCloseButton" TargetType="Button" BasedOn="{StaticResource WinButton}">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="b" Background="Transparent">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="b" Property="Background" Value="#5A2A2A" />
                            <Setter Property="Foreground" Value="#E8C0C0" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="HelpButton" TargetType="ToggleButton">
        <Setter Property="Width" Value="18" />
        <Setter Property="Height" Value="18" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ToggleButton">
                    <Border x:Name="c" CornerRadius="9" Background="{StaticResource BgInput}"
                            BorderBrush="{StaticResource BorderInput}" BorderThickness="1">
                        <TextBlock Text="?" Foreground="{StaticResource TextMuted}" FontFamily="{StaticResource AppFont}"
                                   FontSize="11" FontWeight="SemiBold" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="c" Property="Background" Value="{StaticResource BgNavActive}" />
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="c" Property="Background" Value="{StaticResource AccentBg}" />
                            <Setter TargetName="c" Property="BorderBrush" Value="{StaticResource NavAccent}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <SolidColorBrush x:Key="SeriesCpu" Color="#4A8AA0" />
    <SolidColorBrush x:Key="SeriesRam" Color="#6A7AB0" />
    <SolidColorBrush x:Key="SeriesDisk" Color="#8A6AB0" />
    <SolidColorBrush x:Key="SeriesNet" Color="#4A9A70" />
    <SolidColorBrush x:Key="SeriesGpu" Color="#A08A4A" />
    <SolidColorBrush x:Key="BarTrack" Color="#191919" />
    <SolidColorBrush x:Key="CoreHot" Color="#A04A4A" />
    <SolidColorBrush x:Key="LevelWarm" Color="#C39A52" />
    <SolidColorBrush x:Key="LevelHot" Color="#C05A5A" />

    <Style x:Key="ThinBar" TargetType="ProgressBar">
        <Setter Property="Height" Value="3" />
        <Setter Property="Minimum" Value="0" />
        <Setter Property="Maximum" Value="100" />
        <Setter Property="Background" Value="{StaticResource BarTrack}" />
        <Setter Property="Foreground" Value="{StaticResource AccentText}" />
        <Setter Property="IsTabStop" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ProgressBar">
                    <Grid>
                        <Border x:Name="PART_Track" Background="{TemplateBinding Background}" CornerRadius="1.5" />
                        <Border x:Name="PART_Indicator" Background="{TemplateBinding Foreground}" CornerRadius="1.5"
                                HorizontalAlignment="Left" />
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="KvKey" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource AppFont}" />
        <Setter Property="FontSize" Value="11" />
        <Setter Property="Foreground" Value="{StaticResource TextMuted}" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <Style x:Key="KvValue" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource AppFont}" />
        <Setter Property="FontSize" Value="11" />
        <Setter Property="Foreground" Value="{StaticResource TextName}" />
        <Setter Property="TextAlignment" Value="Right" />
        <Setter Property="TextTrimming" Value="CharacterEllipsis" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <DataTemplate x:Key="KeyValueRowTemplate">
        <Border x:Name="Row" BorderBrush="{StaticResource RowDivider}" BorderThickness="0,0,0,1" Padding="0,6">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="{Binding Key}" Style="{StaticResource KvKey}" Margin="0,0,12,0" />
                <TextBlock x:Name="Val" Grid.Column="1" Text="{Binding Value}" Style="{StaticResource KvValue}" />
            </Grid>
        </Border>
        <DataTemplate.Triggers>
            <DataTrigger Binding="{Binding IsLast}" Value="True">
                <Setter TargetName="Row" Property="BorderThickness" Value="0" />
            </DataTrigger>
            <DataTrigger Binding="{Binding IsMono}" Value="True">
                <Setter TargetName="Val" Property="FontFamily" Value="{StaticResource MonoFont}" />
            </DataTrigger>
        </DataTemplate.Triggers>
    </DataTemplate>

    <SolidColorBrush x:Key="ToneLowFg" Color="#7AB87A" />
    <SolidColorBrush x:Key="ToneLowBg" Color="#1A2E1A" />
    <SolidColorBrush x:Key="ToneLowBorder" Color="#2A462A" />
    <SolidColorBrush x:Key="ToneMediumFg" Color="#C39A52" />
    <SolidColorBrush x:Key="ToneMediumBg" Color="#2A1F0E" />
    <SolidColorBrush x:Key="ToneMediumBorder" Color="#48381A" />
    <SolidColorBrush x:Key="ToneHighFg" Color="#C05A5A" />
    <SolidColorBrush x:Key="ToneHighBg" Color="#2A1010" />
    <SolidColorBrush x:Key="ToneHighBorder" Color="#4A1C1C" />
    <SolidColorBrush x:Key="ToneNeutralFg" Color="#707070" />
    <SolidColorBrush x:Key="ToneNeutralBg" Color="#111111" />
    <SolidColorBrush x:Key="ToneNeutralBorder" Color="#222222" />
    <SolidColorBrush x:Key="ToneInfoFg" Color="#7A9ABA" />
    <SolidColorBrush x:Key="ToneInfoBg" Color="#141A24" />
    <SolidColorBrush x:Key="ToneInfoBorder" Color="#2A3A4A" />
    <SolidColorBrush x:Key="TonePurpleFg" Color="#8A8AC0" />
    <SolidColorBrush x:Key="TonePurpleBg" Color="#1A1A2A" />
    <SolidColorBrush x:Key="TonePurpleBorder" Color="#2A2A3A" />
    <SolidColorBrush x:Key="TableDivider" Color="#151515" />
    <SolidColorBrush x:Key="StatusDotOff" Color="#2A2A2A" />

    <Style x:Key="SegmentedButton" TargetType="Button">
        <Setter Property="FontFamily" Value="{StaticResource AppFont}" />
        <Setter Property="FontSize" Value="11" />
        <Setter Property="Foreground" Value="{StaticResource TextDim}" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderBrush" Value="{StaticResource BorderInput}" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Padding" Value="10,4" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="b" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}" Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Foreground" Value="{StaticResource TextMuted}" />
                        </Trigger>
                        <Trigger Property="Tag">
                            <Trigger.Value><sys:Boolean>True</sys:Boolean></Trigger.Value>
                            <Setter TargetName="b" Property="Background" Value="{StaticResource BgNavActive}" />
                            <Setter Property="Foreground" Value="{StaticResource TextActive}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="DataTableHeader" TargetType="DataGridColumnHeader">
        <Setter Property="Background" Value="{StaticResource BgTitle}" />
        <Setter Property="Foreground" Value="{StaticResource TextFaint}" />
        <Setter Property="FontFamily" Value="{StaticResource AppFont}" />
        <Setter Property="FontSize" Value="10" />
        <Setter Property="Padding" Value="8,7" />
        <Setter Property="BorderBrush" Value="{StaticResource BorderSubtle}" />
        <Setter Property="BorderThickness" Value="0,0,0,1" />
        <Setter Property="HorizontalContentAlignment" Value="Left" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="DataGridColumnHeader">
                    <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}" Padding="{TemplateBinding Padding}">
                        <DockPanel>
                            <TextBlock x:Name="Arrow" DockPanel.Dock="Right" Margin="4,0,0,0" FontSize="9" VerticalAlignment="Center" />
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="Center" />
                        </DockPanel>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Foreground" Value="{StaticResource TextMuted}" />
                        </Trigger>
                        <Trigger Property="SortDirection" Value="Ascending">
                            <Setter TargetName="Arrow" Property="Text" Value="↑" />
                            <Setter Property="Foreground" Value="{StaticResource TextMuted}" />
                        </Trigger>
                        <Trigger Property="SortDirection" Value="Descending">
                            <Setter TargetName="Arrow" Property="Text" Value="↓" />
                            <Setter Property="Foreground" Value="{StaticResource TextMuted}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="DataTableCell" TargetType="DataGridCell">
        <Setter Property="Padding" Value="8,6" />
        <Setter Property="Foreground" Value="{StaticResource TextName}" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="DataGridCell">
                    <Border Background="Transparent" Padding="{TemplateBinding Padding}">
                        <ContentPresenter VerticalAlignment="Center" />
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <Trigger Property="IsSelected" Value="True">
                <Setter Property="Foreground" Value="{StaticResource TextActive}" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="DataTableRow" TargetType="DataGridRow">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderBrush" Value="{StaticResource TableDivider}" />
        <Setter Property="BorderThickness" Value="0,0,0,1" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{StaticResource BgInput}" />
            </Trigger>
            <Trigger Property="IsSelected" Value="True">
                <Setter Property="Background" Value="{StaticResource BgNavActive}" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="DataTable" TargetType="DataGrid">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="RowBackground" Value="Transparent" />
        <Setter Property="AlternatingRowBackground" Value="Transparent" />
        <Setter Property="Foreground" Value="{StaticResource TextName}" />
        <Setter Property="FontFamily" Value="{StaticResource AppFont}" />
        <Setter Property="FontSize" Value="11" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="GridLinesVisibility" Value="None" />
        <Setter Property="HeadersVisibility" Value="Column" />
        <Setter Property="AutoGenerateColumns" Value="False" />
        <Setter Property="IsReadOnly" Value="True" />
        <Setter Property="CanUserAddRows" Value="False" />
        <Setter Property="CanUserDeleteRows" Value="False" />
        <Setter Property="CanUserResizeRows" Value="False" />
        <Setter Property="CanUserReorderColumns" Value="False" />
        <Setter Property="CanUserResizeColumns" Value="False" />
        <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled" />
        <Setter Property="SelectionMode" Value="Single" />
        <Setter Property="SelectionUnit" Value="FullRow" />
        <Setter Property="RowHeaderWidth" Value="0" />
        <Setter Property="EnableRowVirtualization" Value="True" />
        <Setter Property="VirtualizingPanel.IsVirtualizing" Value="True" />
        <Setter Property="VirtualizingPanel.VirtualizationMode" Value="Recycling" />
        <Setter Property="ColumnHeaderStyle" Value="{StaticResource DataTableHeader}" />
        <Setter Property="RowStyle" Value="{StaticResource DataTableRow}" />
        <Setter Property="CellStyle" Value="{StaticResource DataTableCell}" />
    </Style>

    <Style x:Key="TableCellMono" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource MonoFont}" />
        <Setter Property="Foreground" Value="{StaticResource TextDim}" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <Style x:Key="TableCellMonoSmall" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource MonoFont}" />
        <Setter Property="FontSize" Value="10" />
        <Setter Property="Foreground" Value="{StaticResource TextMuted}" />
        <Setter Property="TextTrimming" Value="CharacterEllipsis" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <SolidColorBrush x:Key="DangerBg" Color="#1E1010" />
    <SolidColorBrush x:Key="DangerBorder" Color="#3A1A1A" />
    <SolidColorBrush x:Key="DangerText" Color="#C07070" />
    <SolidColorBrush x:Key="UsageNormal" Color="#8A8A8A" />

    <Style x:Key="DangerButtonSm" TargetType="Button" BasedOn="{StaticResource PillButtonBase}">
        <Setter Property="Background" Value="{StaticResource DangerBg}" />
        <Setter Property="BorderBrush" Value="{StaticResource DangerBorder}" />
        <Setter Property="Foreground" Value="{StaticResource DangerText}" />
        <Setter Property="FontSize" Value="11" />
        <Setter Property="Padding" Value="10,3" />
    </Style>

    <Style x:Key="DataTableHeaderRight" TargetType="DataGridColumnHeader" BasedOn="{StaticResource DataTableHeader}">
        <Setter Property="HorizontalContentAlignment" Value="Right" />
    </Style>

</ResourceDictionary>

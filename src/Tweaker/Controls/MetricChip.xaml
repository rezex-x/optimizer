<UserControl x:Class="Tweaker.Controls.MetricChip"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:Tweaker.Controls"
             x:Name="Root">
    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
        <TextBlock Text="{Binding Label, ElementName=Root}" Style="{StaticResource Label10}" VerticalAlignment="Center" Margin="0,0,6,0" />
        <TextBlock VerticalAlignment="Center" MinWidth="44">
            <Run Text="{Binding Value, ElementName=Root, Mode=OneWay}" FontFamily="{StaticResource MonoFont}"
                 FontSize="11" Foreground="{StaticResource TextActive}" />
            <Run Text="{Binding Unit, ElementName=Root, Mode=OneWay}" FontSize="9" Foreground="{StaticResource TextDim}" />
        </TextBlock>
        <controls:Sparkline Width="64" Height="16" Margin="4,0,0,0" VerticalAlignment="Center"
                            Values="{Binding History, ElementName=Root}" Maximum="{Binding Maximum, ElementName=Root}"
                            SeriesBrush="{Binding SeriesBrush, ElementName=Root}" />
    </StackPanel>
</UserControl>
